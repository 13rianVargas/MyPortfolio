---
import "../styles/global.css";
import Header from "../components/sections/1-Header.astro";
import Footer from "../components/sections/9-Footer.astro";
import Background from "../components/Background.astro";

interface Props {
  lang: string;
  t: (key: any) => string;
}

const { lang, t } = Astro.props;

const SITE = "https://13rian-vargas.vercel.app";
const OG_IMAGE = `${SITE}/og-cover.jpg`;
const canonical = new URL(Astro.url.pathname, SITE).href;

const title = t("head.title");
const description = t("head.description");

const languages = ["en", "es", "fr", "pt"] as const;

// Structured data: lets search engines and AI assistants state the hard facts
// (role, school, credential) instead of guessing them from prose.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Brian Vargas",
  alternateName: "13rian",
  jobTitle: "Java Backend Developer | Full Stack",
  url: SITE,
  image: `${SITE}/og-cover.jpg`,
  // No `email` field on purpose. The whole reason the contact form moved
  // server-side was to keep the address out of the page; publishing it in
  // JSON-LD would hand it straight back to the scrapers.
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bogotá D.C.",
    addressCountry: "CO",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Fundación Universitaria Konrad Lorenz",
  },
  knowsLanguage: ["es", "en"],
  knowsAbout: [
    "Java",
    "Spring Boot",
    "Angular",
    "TypeScript",
    "PostgreSQL",
    "Docker",
    "REST API Design",
    "Cybersecurity",
  ],
  hasCredential: [
    {
      "@type": "EducationalOccupationalCredential",
      name: "CCST Cybersecurity — Cisco Certified Support Technician",
      credentialCategory: "certificate",
      recognizedBy: { "@type": "Organization", name: "Cisco Systems" },
    },
  ],
  sameAs: [
    "https://github.com/13rianVargas",
    "https://www.linkedin.com/in/13rian-vargas/",
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Brian Vargas — Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Brian Vargas — Java Backend Developer | Full Stack" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <meta name="author" content="Brian Vargas" />
    <meta name="robots" content="index, follow" />
    <meta id="theme-color" name="theme-color" content="#f5f5f5" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link rel="icon" type="image/svg+xml" href="/icons/deerhead.svg" />
    <link rel="alternate" hreflang="x-default" href={SITE} />
    {
      languages.map((code) => (
        <link rel="alternate" hreflang={code} href={SITE} />
      ))
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema)}
    />

    <script is:inline>
      /* Theme, resolved before first paint so there is no flash.
       *
       * Stored value is one of "light" | "dark" | "system". An explicit choice
       * wins and survives reload — previously the toggle only lived in memory
       * and every reload snapped back to the OS setting. "system" keeps
       * following the OS live. */
      (function () {
        var KEY = "theme";
        var EVENT = "basecoat:theme";
        var query = window.matchMedia("(prefers-color-scheme: dark)");

        function stored() {
          try {
            var v = localStorage.getItem(KEY);
            return v === "light" || v === "dark" || v === "system" ? v : null;
          } catch (e) {
            return null;
          }
        }

        function resolve(pref) {
          return pref === "system" || !pref
            ? query.matches
              ? "dark"
              : "light"
            : pref;
        }

        function paint(theme) {
          var meta = document.getElementById("theme-color");
          document.documentElement.classList.toggle("dark", theme === "dark");
          if (meta)
            meta.setAttribute(
              "content",
              theme === "dark" ? "#171717" : "#f5f5f5",
            );
        }

        function apply(pref) {
          try {
            localStorage.setItem(KEY, pref);
          } catch (e) {}
          paint(resolve(pref));
        }

        paint(resolve(stored()));

        query.addEventListener("change", function () {
          if (!stored() || stored() === "system") paint(resolve("system"));
        });

        document.addEventListener(EVENT, function () {
          apply(
            document.documentElement.classList.contains("dark")
              ? "light"
              : "dark",
          );
        });

        window.themeManager = {
          get: function () {
            return document.documentElement.classList.contains("dark")
              ? "dark"
              : "light";
          },
          getPreference: function () {
            return stored() || "system";
          },
          set: apply,
          toggle: function () {
            document.dispatchEvent(new CustomEvent(EVENT));
          },
        };
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Background />
    <Header t={t} />
    <main id="main" class="main-content">
      <slot />
    </main>
    <Footer t={t} />

    <style>
      .main-content {
        width: 100%;
        max-width: 100vw;
        overflow-x: clip;
      }
    </style>
  </body>
</html>
