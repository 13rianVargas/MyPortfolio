---
/**
 * Background.astro
 * Clean gray background with interactive water ripple effect
 */
---

<div class="background-gradient"></div>
<div class="noise-overlay"></div>
<div class="chrome-tint chrome-tint-top" aria-hidden="true"></div>
<div class="chrome-tint chrome-tint-bottom" aria-hidden="true"></div>
<div class="ripples-container" id="ripples-container"></div>

<style is:global>
  /* The bands behind Safari 26+'s floating toolbars are NOT part of the page.
   * Measured in the iOS 27 simulator: the screen is 874pt tall and the page
   * viewport only 714pt, with viewport-fit=cover honoured but both
   * safe-area insets reporting 0. Nothing the page paints reaches there —
   * fixed, absolute and the root background were all tried and all stop at
   * the same line.
   *
   * What Safari does instead is TINT those bands from the CSS. The order it
   * settles on, confirmed by experiment:
   *
   *   1. the background-color of a fixed element that is flush with that
   *      edge, spans the full width, is tall enough (24px qualified, 1px did
   *      not) and is not painted over by an opaque layer
   *   2. otherwise body's background-color
   *   3. otherwise the root's
   *
   * Hence these two strips. Each one carries the slice of the gradient that
   * belongs at its edge — background-size is a full viewport and the position
   * pins it top or bottom — so it disappears into the layer behind it, while
   * its background-color is the flat value Safari reads for the band.
   */
  .background-gradient,
  .chrome-tint {
    background-image: linear-gradient(
      135deg,
      var(--bg-gradient-1) 0%,
      var(--bg-gradient-2) 50%,
      var(--bg-gradient-3) 100%
    );
  }

  .background-gradient {
    position: fixed;
    inset: 0;
    z-index: -10;
  }

  .chrome-tint {
    position: fixed;
    left: 0;
    right: 0;
    /* comfortably over the 1px that failed to qualify */
    height: 32px;
    /* above the gradient so nothing paints over it, below the dots */
    z-index: -10;
    pointer-events: none;
    background-size: 100vw 100vh;
    background-repeat: no-repeat;
  }

  .chrome-tint-top {
    top: 0;
    background-position: left top;
    /* The gradient's value at the top edge, mid-width. Measured in the iOS 27
       simulator, this one does NOT win: .site-header is fixed and flush with
       the top edge too, and having no background-color of its own it drops
       Safari to its default light chrome in both themes. Kept because it
       costs nothing and takes over wherever the header is not in the way. */
    background-color: color-mix(
      in srgb,
      var(--bg-gradient-2) 36%,
      var(--bg-gradient-1)
    );
  }

  .chrome-tint-bottom {
    bottom: 0;
    background-position: left bottom;
    background-color: color-mix(
      in srgb,
      var(--bg-gradient-3) 64%,
      var(--bg-gradient-2)
    );
  }

  .noise-overlay {
    position: fixed;
    inset: 0;
    z-index: -9;
    opacity: 0.3;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%239C92AC' fill-opacity='1' fill-rule='evenodd'%3E%3Ccircle cx='3' cy='3' r='1'/%3E%3Ccircle cx='13' cy='13' r='1'/%3E%3C/g%3E%3C/svg%3E");
  }

  /* Fixed, not absolute: as an absolute box it stretched to the full document
     height, which on a long page is a huge composited layer. */
  .ripples-container {
    position: fixed;
    inset: 0;
    z-index: -5;
    pointer-events: none;
    overflow: hidden;
  }

  .ripple {
    position: absolute;
    border-radius: 50%;
    background: transparent;
    border: 4px solid var(--ripple-color);
    box-shadow:
      0 0 40px var(--ripple-color),
      inset 0 0 25px var(--ripple-color);
    backdrop-filter: blur(3px) brightness(1.2) contrast(1.2);
    transform: translate(-50%, -50%) scale(0);
    animation: ripple-expand 2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    pointer-events: none;
  }

  @keyframes ripple-expand {
    0% {
      transform: translate(-50%, -50%) scale(0);
      opacity: 0.8;
    }
    100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ripple {
      animation: none;
      display: none;
    }
  }
</style>

<script src="/Background.js" is:inline></script>
