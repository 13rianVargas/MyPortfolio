---
/**
 * Background.astro
 * Clean gray background with interactive water ripple effect
 */
---

<div class="background-gradient"></div>
<div class="noise-overlay"></div>
<div class="ripples-container" id="ripples-container"></div>

<style is:global>
  /* Bleeding past the viewport on every side, because a fixed layer is pinned
     to the *layout* viewport and Safari's floating address bar hovers outside
     it. At inset: 0 the strip behind the glass fell through to the canvas —
     bare white at first, then a flat shade with no dots once the root took a
     colour. Either way a seam. Overshooting puts the gradient and the dots
     back there, and under the notch and the rubber band while it is at it.

     This only paints if nothing clips it: body used to carry overflow-x,
     which propagates to the viewport and cuts every fixed layer off at
     exactly that edge. It is gone — see global.css. Fixed elements add no
     scrollable overflow of their own, so the extra size costs nothing. */
  .background-gradient {
    position: fixed;
    inset: -10rem;
    z-index: -10;
    background: linear-gradient(
      135deg,
      var(--bg-gradient-1) 0%,
      var(--bg-gradient-2) 50%,
      var(--bg-gradient-3) 100%
    );
  }

  .noise-overlay {
    position: fixed;
    inset: -10rem;
    z-index: -9;
    opacity: 0.3;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%239C92AC' fill-opacity='1' fill-rule='evenodd'%3E%3Ccircle cx='3' cy='3' r='1'/%3E%3Ccircle cx='13' cy='13' r='1'/%3E%3C/g%3E%3C/svg%3E");
  }

  /* Fixed, not absolute: as an absolute box it stretched to the full document
     height, which on a long page is a huge composited layer. */
  .ripples-container {
    position: fixed;
    inset: 0;
    z-index: -5;
    pointer-events: none;
    overflow: hidden;
  }

  .ripple {
    position: absolute;
    border-radius: 50%;
    background: transparent;
    border: 4px solid var(--ripple-color);
    box-shadow:
      0 0 40px var(--ripple-color),
      inset 0 0 25px var(--ripple-color);
    backdrop-filter: blur(3px) brightness(1.2) contrast(1.2);
    transform: translate(-50%, -50%) scale(0);
    animation: ripple-expand 2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    pointer-events: none;
  }

  @keyframes ripple-expand {
    0% {
      transform: translate(-50%, -50%) scale(0);
      opacity: 0.8;
    }
    100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ripple {
      animation: none;
      display: none;
    }
  }
</style>

<script src="/Background.js" is:inline></script>
