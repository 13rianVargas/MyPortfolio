---
import { languages, ui } from "../../i18n/ui";
import { getLangFromUrl } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
---

<div class="language-dropdown-container">
  <button
    id="language-toggle"
    class="language-toggle-btn"
    aria-label="Select language"
    aria-expanded="false"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m5 8 6 6"></path>
      <path d="m4 14 6-6 2-3"></path>
      <path d="M2 5h12"></path>
      <path d="M7 2h1"></path>
      <path d="m22 22-5-10-5 10"></path>
      <path d="M14 18h6"></path>
    </svg>
  </button>

  <div id="language-menu" class="language-menu hidden">
    <ul class="language-list">
      {
        Object.entries(languages).map(([langCode, langData]) => (
          <li>
            <button
              class={`language-option ${lang === langCode ? "active" : ""}`}
              data-lang={langCode}
            >
              <img
                src={langData.flag}
                alt={`${langData.name} flag`}
                class="lang-flag-img"
                width="20"
                height="14"
              />
              <span class="lang-name">{langData.name}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script define:vars={{ translations: ui }}>
  const STORAGE_KEY = "preferred-language";
  const AVAILABLE_LANGS = ["en", "es", "fr", "pt"];
  const DEFAULT_LANG = "en";

  // Detect browser language and map to available languages
  function detectBrowserLanguage() {
    // Get browser languages (array of preferences)
    const browserLangs = navigator.languages || [navigator.language];

    for (const browserLang of browserLangs) {
      // Get the primary language code (e.g., 'es-CO' -> 'es', 'pt-BR' -> 'pt')
      const primaryLang = browserLang.split("-")[0].toLowerCase();

      if (AVAILABLE_LANGS.includes(primaryLang)) {
        return primaryLang;
      }
    }

    // Default to English if no match found
    return DEFAULT_LANG;
  }

  // Get the preferred language (from storage or browser detection)
  function getPreferredLanguage() {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored && AVAILABLE_LANGS.includes(stored)) {
      return stored;
    }
    return detectBrowserLanguage();
  }

  // Save language preference
  function saveLanguagePreference(lang) {
    localStorage.setItem(STORAGE_KEY, lang);
  }

  // Apply language to the page
  function applyLanguage(lang) {
    if (!translations[lang]) return;

    // Update active state in UI
    const options = document.querySelectorAll(".language-option");
    options.forEach((opt) => {
      opt.classList.toggle("active", opt.getAttribute("data-lang") === lang);
    });

    // Dispatch change event to update all translations
    const customEvent = new CustomEvent("language-change", {
      detail: {
        lang: lang,
        translations: translations[lang],
      },
    });
    document.dispatchEvent(customEvent);
  }

  // Initialize language on page load
  function initLanguage() {
    const preferredLang = getPreferredLanguage();

    // Save the detected/preferred language
    saveLanguagePreference(preferredLang);

    // Apply if different from default (en)
    if (preferredLang !== DEFAULT_LANG) {
      applyLanguage(preferredLang);
    } else {
      // Still update UI to show correct active state
      const options = document.querySelectorAll(".language-option");
      options.forEach((opt) => {
        opt.classList.toggle(
          "active",
          opt.getAttribute("data-lang") === preferredLang,
        );
      });
    }
  }

  const toggleBtn = document.getElementById("language-toggle");
  const menu = document.getElementById("language-menu");
  const options = document.querySelectorAll(".language-option");

  // Toggle menu
  toggleBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
    toggleBtn.setAttribute("aria-expanded", (!isExpanded).toString());
    menu?.classList.toggle("hidden");
  });

  // Close menu when clicking outside
  document.addEventListener("click", (e) => {
    if (!menu?.contains(e.target) && !toggleBtn?.contains(e.target)) {
      menu?.classList.add("hidden");
      toggleBtn?.setAttribute("aria-expanded", "false");
    }
  });

  // Handle language selection
  options.forEach((option) => {
    option.addEventListener("click", () => {
      const newLang = option.getAttribute("data-lang");
      if (!newLang) return;

      // Save preference to localStorage
      saveLanguagePreference(newLang);

      // Update active state
      options.forEach((opt) => opt.classList.remove("active"));
      option.classList.add("active");

      // Dispatch change event
      const customEvent = new CustomEvent("language-change", {
        detail: {
          lang: newLang,
          translations: translations[newLang],
        },
      });
      document.dispatchEvent(customEvent);

      // Close menu
      menu?.classList.add("hidden");
      toggleBtn?.setAttribute("aria-expanded", "false");
    });
  });

  // Initialize language detection on DOM ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLanguage);
  } else {
    initLanguage();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener("astro:page-load", initLanguage);
</script>

<style>
  :root {
    --nav-link-stroke: #ffffff;
  }

  :global(.dark) {
    --nav-link-stroke: #000000;
  }

  .language-dropdown-container {
    position: relative;
    display: inline-block;
  }

  .language-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: var(--glass-shadow);
  }

  .language-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
  }

  .language-menu {
    position: absolute;
    top: calc(100% + 1.5rem);
    left: 50%;
    width: max-content;
    background: color-mix(in srgb, var(--amber-color) 15%, var(--glass-bg));
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    box-shadow: var(--glass-shadow);
    padding: 0.5rem;
    z-index: 100;
    transform-origin: top center;
    transition: all 0.2s ease;
    opacity: 1;
    transform: translateX(-50%) scale(1) translateY(0);
  }

  .language-menu.hidden {
    opacity: 0;
    transform: translateX(-50%) scale(0.95) translateY(-10px);
    pointer-events: none;
    visibility: hidden;
  }

  .language-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .language-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: none;
    background: transparent;
    color: var(--color-text-primary);
    cursor: pointer;
    border-radius: 8px;
    font-size: 0.9rem;
    text-align: left;
    /* Ensure all color properties transition simultaneously */
    transition:
      background 0.2s ease,
      color 0.2s ease,
      -webkit-text-stroke 0.2s ease;
  }

  .language-option:hover {
    background: var(--amber-bg);
    color: var(--amber-color);
  }

  .language-option.active {
    background: var(--amber-bg);
    color: var(--amber-color);
    font-weight: 600;
  }

  /* Fix for active items contrast in light mode - force black stroke on yellow text */
  :global(html:not(.dark)) .language-option.active .lang-name,
  :global(html:not(.dark)) .language-option:hover .lang-name {
    -webkit-text-stroke: 1.5px #000000;
  }

  .lang-flag-img {
    width: 20px;
    height: 14px;
    object-fit: cover;
    border-radius: 2px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .lang-name {
    font-size: 0.85rem;
    font-weight: 700;
    -webkit-text-stroke: 1.5px var(--nav-link-stroke);
    paint-order: stroke fill;
    /* Explicitly transition text stroke in sync with parent */
    transition: -webkit-text-stroke 0.2s ease;
  }

  /* Dark mode adjustments */
  :global(.dark) .language-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  :global(.dark) .language-option:hover {
    background: rgba(255, 255, 255, 0.05);
  }
</style>
