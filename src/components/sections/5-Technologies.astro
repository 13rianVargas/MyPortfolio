---
const { t } = Astro.props;

/**
 * Mirrors the CV exactly — that document is the source of truth. Anything
 * listed here that is not on the CV reads as padding to a recruiter who
 * compares the two, so entries are added and removed together.
 */
const GROUPS = [
  {
    key: "frontend",
    items: [
      { name: "HTML5", icon: "html.svg" },
      { name: "CSS3", icon: "css.svg" },
      { name: "JavaScript", icon: "javascript.svg" },
      { name: "TypeScript", icon: "typescript.svg" },
      { name: "Angular", icon: "angular.svg" },
      { name: "Astro", icon: "astro.svg" },
      { name: "Tailwind CSS", icon: "tailwind.svg" },
    ],
  },
  {
    key: "backend",
    items: [
      { name: "Java", icon: "java.svg" },
      { name: "Spring Boot", icon: "spring.svg" },
      { name: "Node.js", icon: "nodejs.svg" },
      { name: "Python", icon: "python.svg" },
      { name: "C++", icon: "cpp.svg" },
      { name: "Kotlin", icon: "kotlin.svg" },
      { name: "Swift", icon: "swift.svg" },
      { name: "REST API Design", icon: "rest-api.svg" },
    ],
  },
  {
    key: "databases",
    items: [
      { name: "PostgreSQL", icon: "postgresql.svg" },
      { name: "MySQL", icon: "mysql.svg" },
      { name: "MongoDB", icon: "mongodb.svg" },
      { name: "MariaDB", icon: "mariadb.svg" },
      { name: "Oracle", icon: "oracle.svg" },
      { name: "PL/SQL", icon: "plsql.svg" },
    ],
  },
  {
    key: "tools",
    items: [
      { name: "Git", icon: "git.svg" },
      { name: "GitHub", icon: "/icons/github.svg" },
      { name: "CI/CD (GitHub Actions)", icon: "github-actions.svg" },
      { name: "Docker", icon: "docker.svg" },
      { name: "Linux CLI", icon: "linux.svg" },
      { name: "Google Cloud", icon: "google-cloud.svg" },
      { name: "Cisco Networking", icon: "cisco.svg" },
      { name: "Cybersecurity", icon: "cybersecurity.svg" },
      { name: "npm", icon: "npm.svg" },
      { name: "pnpm", icon: "pnpm.svg" },
      { name: "Bun", icon: "bun.svg" },
      { name: "Postman", icon: "postman.svg" },
    ],
  },
] as const;

const src = (icon: string) =>
  icon.startsWith("/") ? icon : `/icons/tech/${icon}`;
---

<section id="technologies" class="section-shell">
  <div class="section-container">
    <header class="section-header">
      <p class="section-eyebrow" data-translation-key="technologies.eyebrow">
        {t("technologies.eyebrow")}
      </p>
      <h2 class="section-title" data-translation-key="technologies.title">
        {t("technologies.title")}
      </h2>
      <p class="section-lead" data-translation-key="technologies.description">
        {t("technologies.description")}
      </p>
    </header>

    <div class="docks">
      {
        GROUPS.map((group) => (
          <div class="dock-group">
            <h3
              class="category-title"
              data-translation-key={`technologies.${group.key}`}
            >
              {t(`technologies.${group.key}`)}
            </h3>
            <ul class="dock">
              {group.items.map((tech) => (
                <li class="dock-item">
                  <img
                    src={src(tech.icon)}
                    alt={tech.name}
                    width="48"
                    height="48"
                    loading="lazy"
                  />
                  <span class="dock-tooltip" role="tooltip">
                    {tech.name}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script src="../../i18n/translator.ts"></script>

<script>
  // macOS-dock style magnification on touch: follows the finger across items.
  function initDockTouch() {
    if (!("ontouchstart" in window) && !navigator.maxTouchPoints) return;

    const items = document.querySelectorAll<HTMLElement>(".dock-item");
    if (!items.length) return;

    let active: HTMLElement | null = null;
    let dragging = false;

    const activate = (item: HTMLElement | null) => {
      if (active === item) return;
      active?.classList.remove("touch-active");
      active = item;
      item?.classList.add("touch-active");
    };

    const reset = () => {
      items.forEach((i) => i.classList.remove("touch-active"));
      active = null;
      dragging = false;
    };

    items.forEach((item) =>
      item.addEventListener(
        "touchstart",
        () => {
          dragging = true;
          activate(item);
        },
        { passive: true },
      ),
    );

    document.addEventListener(
      "touchmove",
      (e) => {
        if (!dragging) return;
        const touch = e.touches[0];
        const under = document
          .elementsFromPoint(touch.clientX, touch.clientY)
          .map((el) => el.closest<HTMLElement>(".dock-item"))
          .find(Boolean);
        activate(under ?? null);
      },
      { passive: true },
    );

    document.addEventListener("touchend", () => window.setTimeout(reset, 400), {
      passive: true,
    });
    document.addEventListener("touchcancel", reset, { passive: true });
  }

  document.addEventListener("DOMContentLoaded", initDockTouch);
  document.addEventListener("astro:page-load", initDockTouch);
</script>

<style>
  .section-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .docks {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .dock-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
  }

  .category-title {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .dock {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: var(--space-2xs) var(--space-sm);
    max-width: 100%;
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(140%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(140%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
  }

  .dock-item {
    position: relative;
    width: clamp(34px, 7vw, 46px);
    height: clamp(34px, 7vw, 46px);
    flex-shrink: 0;
    display: grid;
    place-items: center;
    transform-origin: bottom center;
    transition: transform var(--transition-base);
  }

  /* Invisible padding so the pointer does not flicker between items. */
  .dock-item::after {
    content: "";
    position: absolute;
    inset: -14px;
  }

  .dock-item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
  }

  .dock-tooltip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) scale(0.85);
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
    background: #0f172a;
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
    z-index: 5;
  }

  @media (hover: hover) and (pointer: fine) {
    .dock-item:hover {
      transform: scale(1.55) translateY(-12px);
      z-index: 4;
    }
    .dock-item:hover .dock-tooltip,
    .dock-item:focus-within .dock-tooltip {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
  }

  @media (hover: none), (pointer: coarse) {
    .dock-item.touch-active {
      transform: scale(1.45) translateY(-10px);
      z-index: 4;
    }
    .dock-item.touch-active .dock-tooltip {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
  }
</style>
