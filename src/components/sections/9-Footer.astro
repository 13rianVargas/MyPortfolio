---
import Logo from "../tools/Logo.astro";

const { t } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="footer-section">
  <div class="glass-panel footer-bar">
    <div class="footer-brand">
      <Logo size="2rem" />
      <span class="footer-name">13rian</span>
    </div>

    <p class="copyright">
      <span data-translation-key="layout.footer">{t("layout.footer")}</span>
      <span class="dot" aria-hidden="true">•</span>
      <span>{currentYear}</span>
    </p>

    <a href="#home" class="to-top">
      <span class="to-top-text" data-translation-key="layout.scrollTop">
        {t("layout.scrollTop")}
      </span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
        <path d="m18 15-6-6-6 6"></path>
      </svg>
    </a>
  </div>
</footer>

<script src="../../i18n/translator.ts"></script>

<style>
  .footer-section {
    /* Last thing on the page, so it is what Safari's floating address bar
       lands on. The inset keeps the bar from sitting on top of the credit. */
    padding: var(--space-sm) calc(var(--space-sm) + env(safe-area-inset-right))
      calc(var(--space-sm) + env(safe-area-inset-bottom))
      calc(var(--space-sm) + env(safe-area-inset-left));
    position: relative;
    z-index: 2;
  }

  .footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-sm);
    max-width: var(--container-xl);
    margin-inline: auto;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-text-primary);
  }

  .copyright {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
    margin: 0;
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .dot {
    color: var(--color-accent-text);
  }

  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-bg-primary);
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    flex-shrink: 0;
    transition:
      background var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .to-top:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
    transform: translateY(-2px);
  }

  @media (max-width: 520px) {
    .footer-bar {
      flex-wrap: wrap;
      justify-content: center;
    }

    .copyright {
      order: 3;
      flex-basis: 100%;
    }

    .to-top-text {
      display: none;
    }

    .to-top {
      padding: 0.5rem;
      border-radius: 50%;
    }
  }
</style>
