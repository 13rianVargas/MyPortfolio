---
import { Image } from "astro:assets";
import profilePhoto from "../../assets/BrianPhoto.webp";
import portfolioQR from "../../assets/PortfolioQR.svg";
import Logo from "../tools/Logo.astro";

const { t } = Astro.props;
---

<section id="home" class="home-section">
  <div class="home-grid">
    <!-- Intro: the value proposition the old hero never stated. -->
    <div class="intro">
      <p class="intro-eyebrow">
        <span class="status-dot" aria-hidden="true"></span>
        <span data-translation-key="home.workModeValue">
          {t("home.workModeValue")}
        </span>
      </p>

      <h1 class="intro-name" data-translation-key="home.name">
        {t("home.name")}
      </h1>

      <p class="intro-role" data-translation-key="home.role">
        {t("home.role")}
      </p>

      <p class="intro-tagline" data-translation-key="home.tagline">
        {t("home.tagline")}
      </p>

      <div class="intro-actions">
        <a href="#projects" class="btn btn-primary">
          <span data-translation-key="home.ctaProjects">
            {t("home.ctaProjects")}
          </span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <a href="#aboutme" class="btn btn-ghost">
          <span data-translation-key="home.ctaCV">{t("home.ctaCV")}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
        </a>
      </div>

      <ul class="intro-socials">
        <li>
          <a href="https://wa.me/573212256970" target="_blank" rel="noopener noreferrer" class="social whatsapp" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23z" />
              <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z" />
            </svg>
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/in/13rian-vargas/" target="_blank" rel="noopener noreferrer" class="social linkedin" aria-label="LinkedIn">
            <img src="/icons/linkedin.svg" alt="" width="20" height="20" />
          </a>
        </li>
        <li>
          <a href="https://github.com/13rianVargas" target="_blank" rel="noopener noreferrer" class="social github" aria-label="GitHub">
            <img src="/icons/github.svg" alt="" width="20" height="20" />
          </a>
        </li>
      </ul>
    </div>

    <!-- The 3D ID card: the piece of the original design worth keeping. -->
    <div class="card-stage">
      <div class="business-card" id="businessCard">
        <div class="card-face card-front">
          <div class="card-header">
            <Logo size="2.6rem" />
            <button
              class="flip-hint"
              type="button"
              data-flip
              aria-controls="businessCard"
            >
              <span data-translation-key="home.flipCardButton">
                {t("home.flipCardButton")}
              </span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true">
                <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                <path d="M3 3v5h5" />
                <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
                <path d="M16 21h5v-5" />
              </svg>
            </button>
          </div>

          <div class="card-body">
            <div class="photo-ring">
              <Image
                src={profilePhoto}
                alt="Brian Vargas"
                widths={[180, 360, 540]}
                sizes="178px"
                loading="eager"
                fetchpriority="high"
                class="photo"
              />
            </div>
            <p class="card-name" data-translation-key="home.name">
              {t("home.name")}
            </p>
            <p class="card-role" data-translation-key="home.role">
              {t("home.role")}
            </p>
            <p class="card-id">ID: 000-013</p>
          </div>

          <div class="card-footer">
            <div class="card-links">
              <a href="https://wa.me/573212256970" target="_blank" rel="noopener noreferrer" class="card-link" aria-label="WhatsApp">
                <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23z" />
                  <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z" />
                </svg>
                <span>WhatsApp</span>
              </a>
              <a href="https://www.linkedin.com/in/13rian-vargas/" target="_blank" rel="noopener noreferrer" class="card-link">
                <img src="/icons/linkedin.svg" alt="" width="16" height="16" />
                <span>LinkedIn</span>
              </a>
              <a href="https://github.com/13rianVargas" target="_blank" rel="noopener noreferrer" class="card-link">
                <img src="/icons/github.svg" alt="" width="16" height="16" />
                <span>GitHub</span>
              </a>
            </div>
          </div>
        </div>

        <div class="card-face card-back">
          <div class="card-header">
            <Logo size="2.6rem" />
            <button
              class="flip-hint"
              type="button"
              data-flip
              aria-controls="businessCard"
            >
              <span data-translation-key="home.flipCardButton">
                {t("home.flipCardButton")}
              </span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true">
                <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                <path d="M3 3v5h5" />
                <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
                <path d="M16 21h5v-5" />
              </svg>
            </button>
          </div>

          <div class="card-body back-body">
            <div class="qr-block">
              <button class="qr-frame" type="button" id="qr-open" aria-label={t("home.qrInstruction")}>
                <img src={portfolioQR.src} alt="" width="168" height="168" />
              </button>
              <p class="qr-caption" data-translation-key="home.qrInstruction">
                {t("home.qrInstruction")}
              </p>
            </div>

            <dl class="facts">
              <div class="fact">
                <dt data-translation-key="home.factFocus">{t("home.factFocus")}</dt>
                <dd data-translation-key="home.factFocusValue">{t("home.factFocusValue")}</dd>
              </div>
              <div class="fact">
                <dt data-translation-key="home.factStudy">{t("home.factStudy")}</dt>
                <dd data-translation-key="home.factStudyValue">{t("home.factStudyValue")}</dd>
              </div>
              <div class="fact">
                <dt data-translation-key="home.factRole">{t("home.factRole")}</dt>
                <dd data-translation-key="home.factRoleValue">{t("home.factRoleValue")}</dd>
              </div>
              <div class="fact">
                <dt data-translation-key="home.location">{t("home.location")}</dt>
                <dd data-translation-key="home.locationValue">{t("home.locationValue")}</dd>
              </div>
              <div class="fact">
                <dt data-translation-key="home.workMode">{t("home.workMode")}</dt>
                <dd data-translation-key="home.workModeValue">{t("home.workModeValue")}</dd>
              </div>
            </dl>
          </div>

        </div>
      </div>
    </div>
  </div>

  <a href="#aboutme" class="scroll-hint" aria-hidden="true">
    <span data-translation-key="home.scrollHint">{t("home.scrollHint")}</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
      <path d="m6 9 6 6 6-6" />
    </svg>
  </a>
</section>

<div id="qr-modal" class="qr-modal" role="dialog" aria-modal="true" aria-label="QR">
  <div class="qr-overlay" data-close></div>
  <div class="qr-content">
    <button id="qr-close" class="qr-close" type="button" aria-label="Close" data-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" width="22" height="22">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="qr-big">
      <img src={portfolioQR.src} alt="QR" id="qr-image" width="400" height="400" />
    </div>
    <div class="qr-actions">
      <button id="qr-share" class="qr-action" type="button">
        <span data-translation-key="home.shareQR">{t("home.shareQR")}</span>
      </button>
      <button id="qr-download" class="qr-action" type="button">
        <span data-translation-key="home.downloadQR">{t("home.downloadQR")}</span>
      </button>
    </div>
    <p class="qr-feedback" id="qr-feedback" role="status" aria-live="polite"></p>
  </div>
</div>

<script src="../../i18n/translator.ts"></script>

<script>
  function initCard() {
    const card = document.getElementById("businessCard");
    card?.querySelectorAll<HTMLButtonElement>("[data-flip]").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        const flipped = card.classList.toggle("flipped");
        btn.setAttribute("aria-expanded", String(flipped));
      });
    });
  }

  function initQrModal() {
    const modal = document.getElementById("qr-modal");
    const open = document.getElementById("qr-open");
    if (!modal || !open || modal.dataset.bound) return;
    modal.dataset.bound = "true";

    const feedback = document.getElementById("qr-feedback") as HTMLElement;
    const image = document.getElementById("qr-image") as HTMLImageElement;

    const show = () => {
      modal.classList.add("active");
      document.body.style.overflow = "hidden";
      (document.getElementById("qr-close") as HTMLElement)?.focus();
    };
    const hide = () => {
      modal.classList.remove("active");
      document.body.style.overflow = "";
      feedback.textContent = "";
    };

    open.addEventListener("click", show);
    modal
      .querySelectorAll("[data-close]")
      .forEach((el) => el.addEventListener("click", hide));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.classList.contains("active")) hide();
    });

    document.getElementById("qr-share")?.addEventListener("click", async () => {
      const url = window.location.href;
      try {
        if (navigator.share) {
          await navigator.share({ title: document.title, url });
        } else {
          await navigator.clipboard.writeText(url);
          feedback.textContent =
            document
              .querySelector('[data-translation-key="home.qrCopied"]')
              ?.textContent?.trim() || "Link copied";
        }
      } catch {
        /* user dismissed the share sheet — nothing to report */
      }
    });

    document.getElementById("qr-download")?.addEventListener("click", () => {
      const img = new Image();
      img.onload = () => {
        const size = 1024;
        const canvas = document.createElement("canvas");
        canvas.width = canvas.height = size;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;
        ctx.fillStyle = "#fff";
        ctx.fillRect(0, 0, size, size);
        ctx.drawImage(img, 0, 0, size, size);

        const link = document.createElement("a");
        try {
          link.href = canvas.toDataURL("image/png");
          link.download = "BrianVargasPortfolioQR.png";
        } catch {
          link.href = image.src;
          link.download = "BrianVargasPortfolioQR.svg";
        }
        link.click();
      };
      img.src = image.src;
    });
  }

  function init() {
    initCard();
    initQrModal();
  }

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .home-section {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--header-height) + var(--space-lg)) var(--space-sm)
      var(--space-xl);
  }

  .home-grid {
    width: 100%;
    max-width: var(--container-xl);
    margin-inline: auto;
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .home-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--space-xl);
    }
  }

  /* ---------------- Intro ---------------- */

  .intro {
    order: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
  }

  @media (min-width: 1024px) {
    .intro {
      order: 1;
      text-align: left;
      align-items: flex-start;
    }
  }

  .intro-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--glass-bg);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--color-success) 25%, transparent);
  }

  .intro-name {
    font-size: var(--text-5xl);
    font-weight: 700;
    margin: 0;
    color: var(--color-text-primary);
  }

  /* Amber as text on a light page: --color-accent-text is 4.9:1.
   * The raw --color-accent measured 1.33:1 here. */
  .intro-role {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-accent-text);
    margin: 0;
  }

  .intro-tagline {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 46ch;
    margin: var(--space-3xs) 0 0;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
  }

  @media (min-width: 1024px) {
    .intro-actions {
      justify-content: flex-start;
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-full);
    font-size: var(--text-base);
    font-weight: 700;
    transition:
      transform var(--transition-fast),
      background var(--transition-fast),
      border-color var(--transition-fast);
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
    border: 1px solid transparent;
    box-shadow: 0 6px 18px
      color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
  }

  .btn-ghost:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .intro-socials {
    display: flex;
    gap: var(--space-3xs);
    list-style: none;
    margin: var(--space-3xs) 0 0;
    padding: 0;
  }

  .social {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--glass-bg);
    color: var(--color-text-primary);
    transition:
      transform var(--transition-fast),
      background var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .social:hover {
    transform: translateY(-3px);
  }

  .social.whatsapp:hover {
    background: #25d366;
    border-color: #25d366;
    color: #0b2e18;
  }

  .social.linkedin:hover {
    background: #0a66c2;
    border-color: #0a66c2;
  }

  .social.github:hover {
    background: #171717;
    border-color: #171717;
  }

  :global(.dark) .intro-socials img,
  :global(.dark) .card-link img {
    filter: brightness(0) invert(1);
  }

  .social.linkedin:hover img,
  .social.github:hover img {
    filter: brightness(0) invert(1);
  }

  /* ---------------- 3D card ---------------- */

  .card-stage {
    order: 1;
    display: flex;
    justify-content: center;
    perspective: 1400px;
  }

  @media (min-width: 1024px) {
    .card-stage {
      order: 2;
    }
  }

  /* Grid, not absolute positioning: both faces share one cell, so the card is
   * as tall as the TALLER face. With the back absolutely positioned it
   * inherited the front's height and its lower rows were clipped. */
  .business-card {
    display: grid;
    width: min(100%, 360px);
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    transform: rotateY(-6deg) rotateX(2deg);
    transition: transform 0.85s var(--ease-flip);
    will-change: transform;
  }

  .business-card.flipped {
    transform: rotateY(-186deg) rotateX(2deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .business-card:hover {
      transform: rotateY(-9deg) rotateX(3deg) scale(1.02);
    }
    .business-card.flipped:hover {
      transform: rotateY(-189deg) rotateX(3deg) scale(1.02);
    }
  }

  /* Flat on touch: the tilt reads as a rendering glitch on small screens. */
  @media (hover: none) and (pointer: coarse) {
    .business-card,
    .business-card:hover {
      transform: none;
    }
    .business-card.flipped {
      transform: rotateY(-180deg);
    }
  }

  .card-face {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--glass-bg-strong);
    backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    border: 1px solid var(--glass-border);
    box-shadow: 0 24px 60px var(--color-shadow);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .card-face {
    grid-area: 1 / 1;
    height: 100%;
  }

  .card-front {
    z-index: 2;
  }

  .card-back {
    transform: rotateY(180deg);
    z-index: 1;
  }

  .business-card.flipped .card-front {
    z-index: 1;
  }
  .business-card.flipped .card-back {
    z-index: 2;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-xs);
    background: linear-gradient(
      135deg,
      var(--color-accent),
      var(--color-accent-hover)
    );
  }

  .flip-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-on-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-on-accent) 22%, transparent);
    color: var(--color-on-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background var(--transition-fast), transform var(--transition-fast);
