---
import Logo from "../tools/Logo.astro";
const { t } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="footer-section">
  <div class="glass-footer">
    <div class="footer-content">
      <div class="footer-logo">
        <Logo />
      </div>

      <div class="copyright">
        <span data-translation-key="layout.footer">{t("layout.footer")}</span>
        <span class="separator">•</span>
        <span class="year">{currentYear}</span>
      </div>

      <div class="footer-links">
        <a href="#home" class="footer-link" aria-label="Back to top">
          <span class="scroll-text" data-translation-key="layout.scrollTop"
            >{t("layout.scrollTop")}</span
          >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m18 15-6-6-6 6"></path></svg
          >
        </a>
      </div>
    </div>
  </div>
</footer>

<script src="../../i18n/translator.ts"></script>

<style>
  .footer-section {
    padding: clamp(1rem, 3vw, 2rem);
    position: relative;
    z-index: 10;
    margin-top: auto;
  }

  .glass-footer {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    border-radius: clamp(12px, 2.5vw, 20px);
    padding: clamp(1rem, 2vw, 1.5rem) clamp(1rem, 3vw, 2rem);
    max-width: min(100%, 1200px);
    margin: 0 auto;
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(0.5rem, 2vw, 1rem);
    flex-wrap: nowrap;
  }

  .footer-logo {
    flex-shrink: 0;
    transform: scale(clamp(0.5, 0.6 + 0.1vw, 0.8));
    transform-origin: left center;
  }

  .copyright {
    color: var(--color-text-secondary);
    font-size: clamp(0.65rem, 1.5vw, 0.9rem);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    justify-content: center;
    text-align: center;
    flex: 1;
    min-width: 0;
  }

  .separator {
    color: var(--color-accent);
  }

  .footer-links {
    display: flex;
    flex-shrink: 0;
  }

  .footer-link {
    padding: clamp(0.4rem, 1vw, 0.6rem) clamp(0.8rem, 1.5vw, 1.2rem);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border);
    color: var(--color-text-primary);
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .scroll-text {
    font-size: clamp(0.7rem, 1.5vw, 0.9rem);
    font-weight: 500;
    white-space: nowrap;
  }

  .footer-link svg {
    width: clamp(14px, 2.5vw, 20px);
    height: clamp(14px, 2.5vw, 20px);
  }

  .footer-link:hover {
    background: var(--color-accent);
    color: white;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
  }

  /* En pantallas muy pequeñas, ocultar el texto para evitar desbordamiento si es necesario, 
     pero el usuario lo pidió explícitamente, así que intentaremos mantenerlo. 
     Podemos reducir el padding o el tamaño de fuente en móviles extremos. */
  @media (max-width: 400px) {
    .separator {
      display: none;
    }

    .copyright {
      flex-direction: column;
      gap: 0.1rem;
    }

    .scroll-text {
      display: none; /* Ocultar texto en pantallas muy pequeñas para mantener el layout limpio */
    }

    .footer-link {
      padding: 0.5rem;
      border-radius: 50%;
      width: 36px;
      height: 36px;
    }
  }
</style>
