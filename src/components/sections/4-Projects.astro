const { t } = Astro.props;

// Configuration for projects to display
const REPOSITORIES = [
  {
    slug: "K-Forge/KForge-Home",
    tech: ["Angular", "TypeScript", "Tailwind CSS", "HTML", "CSS"],
  },
  {
    slug: "K-Forge/K-APP",
  },
  {
    slug: "K-Forge/Gretta",
    tech: [
      "Angular",
      "TypeScript",
      "Java",
      "Spring Boot",
      "MySQL",
      "HTML",
      "CSS",
    ],
  },
  {
    slug: "K-Forge/Tienda-K",
  },
  {
    slug: "13rianVargas/SpemTraductor",
  },
  {
    slug: "13rianVargas/MyPortfolio",
    tech: ["Astro", "TypeScript", "Tailwind CSS", "HTML", "CSS"],
  },
];

// Order of technologies for sorting
const TECH_PRIORITY = [
  "HTML",
  "HTML5",
  "CSS",
  "CSS3",
  "JavaScript",
  "JS",
  "TypeScript",
  "TS",
  "Astro",
  "Angular",
  "Tailwind CSS",
  "Tailwind",
  "Java",
  "Spring Boot",
  "Spring",
  "Node.js",
  "Node",
  "Python",
  "REST APIs Design",
  "PostgreSQL",
  "Postgres",
  "MySQL",
  "MongoDB",
  "MariaDB",
  "Oracle Database (PL/SQL)",
  "Oracle",
  "PL/SQL",
  "Git",
  "GitHub",
  "Docker",
  "Linux",
  "CI/CD (GitHub Actions)",
  "GitHub Actions",
  "AWS (EC2, S3, RDS)",
  "AWS",
  "Google Cloud",
  "GCP",
  "Cisco Networking Academy – Networking & Cybersecurity",
  "Cisco",
  "npm",
  "pnpm",
  "Bun",
  "Postman",
  "GitKraken",
];

function getTechIconFilename(tech: string) {
  const key = tech.toLowerCase();

  // Map common variations to standard filenames
  if (key.includes("astro")) return "astro.svg";
  if (key.includes("python")) return "python.svg";
  if (key.includes("java") && !key.includes("script")) return "java.svg";
  if (key.includes("mysql")) return "mysql.svg";
  if (key.includes("plpgsql") || key.includes("postgres"))
    return "postgresql.svg";
  if (key.includes("type") && key.includes("script")) return "typescript.svg";
  if (key.includes("java") && key.includes("script")) return "javascript.svg";
  if (key.includes("html")) return "html.svg";
  if (key.includes("scss") || key.includes("sass")) return "scss.svg";
  if (key.includes("tailwind")) return "tailwind.svg";
  if (key.includes("css")) return "css.svg";
  if (key.includes("angular")) return "angular.svg";
  if (key.includes("docker")) return "docker.svg";
  if (key.includes("gitkraken")) return "gitkraken.svg";
  if (key.includes("github")) return "../github.svg";
  if (key.includes("git")) return "git.svg";
  if (key.includes("spring")) return "spring.svg";

  // Default: use the tech name as filename (e.g. "rust" -> "rust.svg")
  return `${key.replace(/[^a-z0-9]/g, "")}.svg`;
}

async function fetchProjectData(repoConfig: any) {
  try {
    if (!repoConfig.slug) return repoConfig;

    const headers: Record<string, string> = {
      Accept: "application/vnd.github.v3+json",
    };

    const token = import.meta.env.GITHUB_TOKEN;
    if (token) {
      headers["Authorization"] = `token ${token}`;
    }

    const response = await fetch(
      `https://api.github.com/repos/${repoConfig.slug}`,
      { headers },
    );

    if (!response.ok) {
      console.error(
        `Failed to fetch data for ${repoConfig.slug}: ${response.statusText}`,
      );
      return {
        title: repoConfig.slug.split("/")[1],
        description: "Project details could not be loaded.",
        tech: [],
        link: null,
        github: "#",
        ...repoConfig,
      };
    }

    const data = await response.json();

    // Fetch languages
    let languages: string[] = [];
    try {
      const langResponse = await fetch(data.languages_url, { headers });
      if (langResponse.ok) {
        const langData = await langResponse.json();
        languages = Object.keys(langData);
      }
    } catch (e) {
      console.warn(`Could not fetch languages for ${repoConfig.slug}`);
    }

    // Resolve project cover image:
    // 1) Explicit image from config
    // 2) Automatic screenshot from production URL (homepage)
    // 3) GitHub Open Graph image (auto-generated per repository)
    const productionUrl = repoConfig.link || data.homepage;
    const normalizedProductionUrl = productionUrl
      ? /^https?:\/\//i.test(productionUrl)
        ? productionUrl
        : `https://${productionUrl}`
      : null;
    const screenshotUrl = normalizedProductionUrl
      ? `https://s.wordpress.com/mshots/v1/${encodeURIComponent(normalizedProductionUrl)}?w=1200`
      : null;

    // Only use explicit image or WordPress screenshot — no OG fallback.
    // If neither exists, imageUrl stays null and the UFO placeholder shows.
    const imageUrl = repoConfig.image || screenshotUrl || null;

    // Process Tech Stack
    const detectedTech =
      (languages.length > 0 ? languages : data.topics) ||
      [data.language].filter(Boolean);

    let techStack = [
      ...detectedTech.filter(Boolean),
      ...(repoConfig.tech || []).filter(Boolean),
    ];

    // Remove duplicates while keeping first occurrence
    techStack = techStack.filter(
      (tech: string, index: number, list: string[]) =>
        list.findIndex(
          (item: string) => item.toLowerCase() === tech.toLowerCase(),
        ) === index,
    );

    // 1. Java -> Add Spring
    const hasJava = techStack.some(
      (t: string) =>
        t.toLowerCase().includes("java") && !t.toLowerCase().includes("script"),
    );
    if (hasJava) {
      const hasSpring = techStack.some((t: string) =>
        t.toLowerCase().includes("spring"),
      );
      if (!hasSpring) {
        techStack.push("Spring Boot");
      }
    }

    // 2. PLPGSQL -> PostgreSQL
    techStack = techStack.map((t: string) => {
      if (t.toUpperCase() === "PLPGSQL") return "PostgreSQL";
      if (t.toLowerCase() === "spring") return "Spring Boot";
      return t;
    });

    // Sort tech stack based on priority
    techStack.sort((a: string, b: string) => {
      const getPriority = (tech: string) => {
        const index = TECH_PRIORITY.findIndex(
          (t) => t.toLowerCase() === tech.toLowerCase(),
        );
        return index === -1 ? 999 : index;
      };
      return getPriority(a) - getPriority(b);
    });

    return {
      title: repoConfig.title || data.name,
      description: repoConfig.description || data.description,
      link: data.homepage, // Only if homepage is set
      github: data.html_url,
      image: imageUrl,
      stars: data.stargazers_count,
      forks: data.forks_count,
      ...repoConfig,
      tech: techStack,
    };
  } catch (error) {
    console.error(`Error fetching ${repoConfig.slug}:`, error);
    return repoConfig;
  }
}

const projects = await Promise.all(REPOSITORIES.map(fetchProjectData));
---

<section id="projects" class="projects-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title" data-translation-key="projects.title">
        {t("projects.title")}
      </h2>
      <p class="section-subtitle" data-translation-key="projects.description">
        {t("projects.description")}
      </p>
    </div>

    <div class="projects-grid">
      {
        projects.map((project: any) => (
          <div class="project-card">
            <div class="card-image">
              <div class="card-image-inner">
                {project.image ? (
                  <>
                    <img
                      src={project.image}
                      alt={project.title}
                      class="project-img"
                      loading="lazy"
                      data-project-title={project.title}
                      data-project-slug={project.slug}
                      onload="handleProjectImageLoad(this)"
                      onerror="handleProjectImageError(this)"
                    />
                    <div class="fun-placeholder wip-scene image-fallback-hidden">
                      <div class="construction-tape top-tape" />
                      <div class="wip-content">
                        <div class="hardhat">
                          <img src="/icons/helmet.svg" alt="WIP" />
                        </div>
                        <span
                          class="placeholder-text"
                          data-translation-key="projects.imageAbducted"
                        >
                          {t("projects.imageAbducted")}
                        </span>
                      </div>
                      <div class="construction-tape bottom-tape" />
                    </div>
                  </>
                ) : (
                  <div class="fun-placeholder wip-scene">
                    <div class="construction-tape top-tape" />
                    <div class="wip-content">
                      <div class="hardhat">
                        <img src="/icons/helmet.svg" alt="WIP" />
                      </div>
                      <span
                        class="placeholder-text"
                        data-translation-key="projects.imageAbducted"
                      >
                        {t("projects.imageAbducted")}
                      </span>
                    </div>
                    <div class="construction-tape bottom-tape" />
                  </div>
                )}
                <div class="overlay" />
              </div>
            </div>

            <div class="card-content">
              <h3 class="project-title">{project.title}</h3>
              <div class="card-body">
                <p
                  class="project-description"
                  data-translation-key={`projects.repo.${project.slug.split("/")[1].toLowerCase()}`}
                >
                  {t(
                    `projects.repo.${project.slug.split("/")[1].toLowerCase()}`,
                  )}
                </p>

                <div class="tech-stack">
                  {project.tech
                    .filter(
                      (tech: string) =>
                        !["shell", "powershell"].includes(tech.toLowerCase()),
                    )
                    .map((tech: string) => (
                      <span class="tech-badge">
                        <img
                          src={`/icons/tech/${getTechIconFilename(tech)}`}
                          alt={tech}
                          class="tech-icon"
                          width="40"
                          height="40"
                          loading="lazy"
                          onerror="this.style.display='none'"
                        />
                        {tech}
                      </span>
                    ))}
                </div>
              </div>

              <div class="card-actions">
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="action-btn github"
                >
                  <span data-translation-key="projects.code">
                    {t("projects.code")}
                  </span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                </a>
                <a
                  href={project.link || "#"}
                  target={project.link ? "_blank" : "_self"}
                  rel="noopener noreferrer"
                  class={`action-btn demo ${!project.link ? "no-demo" : ""}`}
                  onclick={
                    !project.link ? "event.preventDefault(); showToast();" : ""
                  }
                >
                  <span data-translation-key="projects.liveDemo">
                    {t("projects.liveDemo")}
                  </span>
                  {project.link ? (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  ) : (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                    </svg>
                  )}
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <div id="toast" data-translation-key="projects.liveDemoUnavailable">
      {t("projects.liveDemoUnavailable")}
    </div>
  </div>
</section>

<script is:inline>
  function showToast() {
    const toast = document.getElementById("toast");
    toast.className = "show";
    setTimeout(function () {
      toast.className = toast.className.replace("show", "");
    }, 3000);
  }

  function handleProjectImageLoad(img) {
    // Image loaded successfully — no dynamic sizing needed,
    // frame uses object-fit: cover to fill the area.
  }

  function handleProjectImageError(img) {
    img.style.display = "none";

    const fallback = img.nextElementSibling;
    if (fallback && fallback.classList.contains("fun-placeholder")) {
      fallback.style.display = "flex";
    }

    const projectTitle = img.dataset.projectTitle || "unknown-title";
    const projectSlug = img.dataset.projectSlug || "unknown-slug";
    const attemptedUrl = img.currentSrc || img.src;

    console.warn(
      `[Projects] Screenshot missing or unreachable for ${projectTitle} (${projectSlug})`,
      attemptedUrl,
    );
  }
</script>

<script src="../../i18n/translator.ts"></script>

<style>
  .projects-section {
    min-height: 100vh;
    min-height: 100dvh;
    padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 3vw, 2rem);
    position: relative;
    z-index: 1;
  }

  .container {
    max-width: min(100%, 1200px);
    margin: 0 auto;
    width: 100%;
  }

  .section-header {
    text-align: center;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
    display: inline-block;
    position: relative;
  }

  .section-title::after {
    content: "";
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(50px, 10vw, 80px);
    height: 4px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  .section-subtitle {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--color-text-secondary);
    max-width: min(100%, 600px);
    margin: clamp(1rem, 3vw, 2rem) auto;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 350px), 1fr));
    gap: clamp(1.5rem, 4vw, 2.5rem);
    justify-items: center;
    max-width: 1000px;
    margin: 0 auto;
  }

  .project-card {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    border-radius: clamp(12px, 2vw, 20px);
    overflow: hidden;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 450px;
  }

  .project-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  .card-image {
    --media-frame-gap: clamp(0.5rem, 1.2vw, 0.75rem);
    --media-radius: clamp(8px, 1.4vw, 14px);
    aspect-ratio: 16 / 9;
    max-height: 320px;
    width: 100%;
    position: relative;
    padding: var(--media-frame-gap);
    background:
      radial-gradient(
        circle at 15% 15%,
        rgba(124, 58, 237, 0.15),
        transparent 45%
      ),
      radial-gradient(
        circle at 85% 85%,
        rgba(59, 130, 246, 0.12),
        transparent 40%
      ),
      rgba(2, 6, 23, 0.6);
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  /* Inner frame that clips the image & hover zoom */
  .card-image-inner {
    width: 100%;
    height: 100%;
    border-radius: var(--media-radius);
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.04),
      0 6px 18px rgba(15, 23, 42, 0.3);
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.5s ease;
  }

  .project-card:hover .project-img {
    transform: scale(1.05);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.15);
    transition: background 0.3s ease;
    z-index: 1;
  }

  .fun-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
    overflow: hidden;
    position: relative;
    border-radius: var(--media-radius);
  }

  .image-fallback-hidden {
    display: none;
  }

  /* === Construction tape stripes === */
  .construction-tape {
    width: 100%;
    height: clamp(7px, 1.5vw, 10px);
    background: repeating-linear-gradient(
      -45deg,
      #fbbf24,
      #fbbf24 8px,
      #1a1a1a 8px,
      #1a1a1a 16px
    );
    flex-shrink: 0;
    opacity: 0.6;
  }

  .top-tape {
    border-radius: var(--media-radius) var(--media-radius) 0 0;
  }

  .bottom-tape {
    border-radius: 0 0 var(--media-radius) var(--media-radius);
  }

  /* === WIP center content === */
  .wip-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.4rem, 1.5vw, 0.8rem);
    z-index: 2;
  }

  .hardhat {
    width: clamp(60px, 14vw, 90px);
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 0 12px rgba(251, 191, 36, 0.35));
    animation: hardhat-float 3s ease-in-out infinite;
  }

  .hardhat img {
    width: 100%;
    height: 100%;
  }

  .placeholder-text {
    font-family: monospace;
    font-size: clamp(0.8rem, 1.8vw, 1.1rem);
    font-weight: 700;
    color: #fbbf24;
    text-transform: uppercase;
    letter-spacing: 3px;
    z-index: 2;
    text-shadow:
      0 0 8px rgba(251, 191, 36, 0.4),
      0 1px 2px rgba(0, 0, 0, 0.6);
  }

  /* === Keyframes === */
  @keyframes hardhat-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .project-card:hover .overlay {
    background: rgba(0, 0, 0, 0);
  }

  .card-content {
    padding: clamp(1rem, 3vw, 2rem);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .project-title {
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-weight: 700;
    margin-bottom: clamp(0.5rem, 1vw, 0.8rem);
    color: var(--color-text-primary);
  }

  .project-description {
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.5rem, 1.5vw, 0.8rem);
    justify-content: center;
    align-items: center;
  }

  .tech-badge {
    font-size: clamp(0.7rem, 1.2vw, 0.8rem);
    padding: clamp(0.3rem, 0.8vw, 0.5rem);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border);
    border-radius: clamp(8px, 1.5vw, 12px);
    color: var(--color-text-primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    min-width: clamp(50px, 10vw, 60px);
    transition: all 0.2s ease;
  }

  :global(html:not(.dark)) .tech-badge {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.05);
    color: var(--color-text-secondary);
  }

  .tech-badge:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

