---
import { Image } from "astro:assets";
import kforgeCover from "../../assets/projects/kforge.webp";
import kappCover from "../../assets/projects/kapp.webp";
import amodelCover from "../../assets/projects/amodel.webp";
import spemCover from "../../assets/projects/spemtraductor.webp";
import portfolioCover from "../../assets/projects/myportfolio.webp";

const { t } = Astro.props;

/**
 * Project data lives here, not in the GitHub API.
 *
 * The previous version fetched every repo at build time. That made the build
 * depend on a token and on GitHub being reachable, and two slugs had gone
 * stale after the repos were renamed (KForge-Home -> K-Forge, K-APP -> KApp)
 * — it only kept working because GitHub was still 301-ing the old names.
 *
 * `video`: YouTube id. When set, the card renders a click-to-load player.
 *          Paste an id and it appears — nothing else to change.
 * `demo` : deployed URL, or null when there is none.
 */
const PROJECTS = [
  {
    id: "kapp",
    cover: kappCover,
    repo: "https://github.com/K-Forge/KApp",
    demo: "https://kapp-black.vercel.app",
    demoLabel: "projects.prototype", // front-end prototype, not a live product
    video: "",
    tech: [
      "Java",
      "Spring Boot",
      "Spring Cloud",
      "REST API Design",
      "PostgreSQL",
      "Docker",
      "Kotlin",
      "Swift",
      "Maven",
    ],
  },
  {
    // demo stays null on purpose: this one is a video walkthrough, not a site.
    // Paste the YouTube id into `video` and the card swaps the placeholder for
    // a click-to-load player and the button label for "Video".
    id: "amodel",
    cover: amodelCover,
    repo: "https://github.com/13rianVargas/A-Minecraft-Ordinary-Differential-Equation-Lab",
    demo: null,
    demoLabel: "projects.liveDemo",
    video: "", // ← paste the YouTube id here when the walkthrough is ready
    tech: [
      "Python",
      "NumPy",
      "SciPy",
      "pandas",
      "Matplotlib",
      "pytest",
      "Docker",
      "Linux CLI",
      "VPS",
      "Tailscale",
    ],
  },
  {
    id: "kforge",
    cover: kforgeCover,
    repo: "https://github.com/K-Forge/K-Forge",
    demo: "https://kforge.vercel.app",
    demoLabel: "projects.liveDemo",
    video: "",
    tech: [
      "Angular",
      "TypeScript",
      "Tailwind CSS",
      "HTML",
      "CSS",
      "Bun",
      "GitHub API",
      "Vercel",
    ],
  },
  {
    id: "spemtraductor",
    cover: spemCover,
    repo: "https://github.com/13rianVargas/SpemTraductor",
    demo: "https://spem-traductor.vercel.app",
    demoLabel: "projects.liveDemo",
    video: "",
    tech: ["JavaScript", "HTML", "CSS", "Vercel"],
  },
  {
    id: "myportfolio",
    cover: portfolioCover,
    repo: "https://github.com/13rianVargas/MyPortfolio",
    demo: "https://13rian-vargas.vercel.app",
    demoLabel: "projects.liveDemo",
    video: "",
    tech: [
      "Astro",
      "TypeScript",
      "HTML",
      "CSS",
      "pnpm",
      "CI/CD (GitHub Actions)",
      "Vercel",
    ],
  },
] as const;

const TECH_ICONS: Record<string, string> = {
  java: "java.svg",
  "spring boot": "spring.svg",
  "spring cloud": "spring.svg",
  "rest api design": "rest-api.svg",
  postgresql: "postgresql.svg",
  docker: "docker.svg",
  kotlin: "kotlin.svg",
  swift: "swift.svg",
  angular: "angular.svg",
  typescript: "typescript.svg",
  "tailwind css": "tailwind.svg",
  bun: "bun.svg",
  pnpm: "pnpm.svg",
  python: "python.svg",
  javascript: "javascript.svg",
  html: "html.svg",
  css: "css.svg",
  astro: "astro.svg",
  "github api": "/icons/github.svg",
  "ci/cd (github actions)": "github-actions.svg",
  vercel: "vercel.svg",
  maven: "maven.svg",
  numpy: "numpy.svg",
  scipy: "scipy.svg",
  pandas: "pandas.svg",
  matplotlib: "matplotlib.svg",
  pytest: "pytest.svg",
  "linux cli": "linux.svg",
  vps: "vps.svg",
  tailscale: "tailscale.svg",
  ssh: "ssh.svg",
};

// Not every tool ships an icon we have (NumPy, pytest, Vercel…). Those render
// as text-only chips rather than being dropped, so the stack stays honest.
function iconFor(tech: string): string | null {
  const file = TECH_ICONS[tech.toLowerCase()];
  if (!file) return null;
  return file.startsWith("/") ? file : `/icons/tech/${file}`;
}
---

<section id="projects" class="section-shell projects-section">
  <div class="section-container">
    <header class="section-header">
      <p class="section-eyebrow" data-translation-key="projects.eyebrow">
        {t("projects.eyebrow")}
      </p>
      <h2 class="section-title" data-translation-key="projects.title">
        {t("projects.title")}
      </h2>
      <p class="section-lead" data-translation-key="projects.description">
        {t("projects.description")}
      </p>
    </header>

    <div
      class="projects-grid"
      data-cancel-egg={t("projects.cancelEgg")}
      data-unmute={t("projects.unmute")}
    >
      {
        PROJECTS.map((project) => (
          <article class="project-card" data-project={project.id}>
            {/* The cover is always the resting state. Video only ever appears
                after someone asks for it, and the card returns here when it
                ends. No YouTube thumbnail, no third-party request on load. */}
            <div class="card-media" data-video-id={project.video || null}>
              <Image
                src={project.cover}
                alt=""
                widths={[400, 700]}
                sizes="(min-width: 900px) 420px, 100vw"
                loading="lazy"
                class="cover"
              />
            </div>

            <div class="card-body">
              <h3
                class="project-title"
                data-translation-key={`projects.repo.${project.id}.title`}
              >
                {t(`projects.repo.${project.id}.title`)}
              </h3>

              <p
                class="project-description"
                data-translation-key={`projects.repo.${project.id}`}
              >
                {t(`projects.repo.${project.id}`)}
              </p>

              <ul class="tech-stack">
                {project.tech.map((tech) => {
                  const icon = iconFor(tech);
                  return (
                    <li class="tech-chip">
                      {icon && (
                        <img src={icon} alt="" width="16" height="16" loading="lazy" />
                      )}
                      <span>{tech}</span>
                    </li>
                  );
                })}
              </ul>

              <div class="card-actions">
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-ghost"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                  <span data-translation-key="projects.code">{t("projects.code")}</span>
                </a>

                {project.demo ? (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary"
                  >
                    <span data-translation-key={project.demoLabel}>
                      {t(project.demoLabel)}
                    </span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  </a>
                ) : project.video ? (
                  <button class="btn btn-primary js-play-video" type="button">
                    <img
                      src="/icons/youtube.svg"
                      alt=""
                      width="16"
                      height="16"
                      class="yt-icon"
                    />
                    <span data-translation-key="projects.watchDemo">
                      {t("projects.watchDemo")}
                    </span>
                  </button>
                ) : (
                  <span class="btn btn-disabled" aria-disabled="true">
                    <img
                      src="/icons/youtube.svg"
                      alt=""
                      width="16"
                      height="16"
                      class="yt-icon"
                    />
                    <span data-translation-key="projects.videoSoon">
                      {t("projects.videoSoon")}
                    </span>
                  </span>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script src="../../i18n/translator.ts"></script>

<script>
  /**
   * Project media has exactly three states, and the cover is home base:
   *
   *   cover  --[ Video button ]-->  real walkthrough
   *   cover  --[ 13 logo clicks ]->  rickroll        (easter egg)
   *   any video --[ ends / STOP ]-->  cover
   *
   * Nothing is embedded until someone asks. A YouTube iframe pulls ~700 KB of
   * third-party JS on load, so the card ships an image and swaps it in place.
   */
  const YT_ORIGIN = "https://www.youtube-nocookie.com";
  const RICKROLL = "dQw4w9WgXcQ";
  const CLICKS_TO_ARM = 13;

  // Safari — on the desktop and underneath every iOS browser — pauses a clip
  // the moment it is unmuted without a fresh tap of its own, so there the
  // volume stays down until the viewer asks for it. Everywhere else the player
  // API can raise it as soon as playback starts.
  const KEEPS_MUTED = /apple/i.test(navigator.vendor);

  interface CardState {
    card: HTMLElement;
    media: HTMLElement;
    actions: HTMLElement;
    coverHTML: string;
    buttonHTML: string;
    realVideo: string | null;
    cancelLabel: string;
    unmuteLabel: string;
    onMessage: ((e: MessageEvent) => void) | null;
    blockHomeJump: ((e: MouseEvent) => void) | null;
    clicks: number;
  }

  function command(frame: HTMLIFrameElement, func: string, args: unknown[] = []) {
    frame.contentWindow?.postMessage(
      JSON.stringify({ event: "command", func, args }),
      YT_ORIGIN,
    );
  }

  function soundButton(state: CardState) {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "sound-on";
    // The global `svg { height: auto }` reset collapses an unsized icon to
    // 0x0, so this one carries its box inline.
    button.innerHTML =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" ' +
      'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" ' +
      'style="width:16px;height:16px;flex-shrink:0">' +
      '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>' +
      '<path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5a9 9 0 0 1 0 14"/></svg>' +
      `<span>${state.unmuteLabel}</span>`;
    return button;
  }

  function mountPlayer(state: CardState, videoId: string, onEnded: () => void) {
    const frame = document.createElement("iframe");
    // Muted playback is the only kind every browser will start on its own, and
    // iOS hands an un-flagged clip to the fullscreen native player instead of
    // running it inside the card — both flags are load-bearing on mobile.
    // Sound comes back on right below, once the player is actually rolling.
    const params = new URLSearchParams({
      autoplay: "1",
      mute: "1",
      playsinline: "1",
      rel: "0",
      enablejsapi: "1",
      origin: location.origin,
    });
    frame.src = `${YT_ORIGIN}/embed/${videoId}?${params}`;
    frame.title = "Video";
    frame.allow =
      "accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture";
    frame.allowFullscreen = true;

    const sound = soundButton(state);
    const enableSound = () => {
      if (!sound.isConnected) return;
      command(frame, "unMute");
      command(frame, "setVolume", [100]);
      sound.remove();
    };
    sound.addEventListener("click", enableSound);
    state.media.replaceChildren(frame, sound);

    // Subscribing over the player's own postMessage channel avoids loading the
    // YouTube iframe API just to learn when playback finished.
    frame.addEventListener("load", () => {
      frame.contentWindow?.postMessage(
        JSON.stringify({ event: "listening", id: 1, channel: "widget" }),
        YT_ORIGIN,
      );
    });

    state.onMessage = (event: MessageEvent) => {
      if (event.origin !== YT_ORIGIN) return; // only trust the player itself
      try {
        const data = JSON.parse(event.data);
        const playerState = data?.info?.playerState;
        if (playerState === 0) onEnded(); // 0 === ENDED
        // 1 === PLAYING. Waiting for it rather than for onReady means the
        // volume only goes up on a clip that really did start.
        if (!KEEPS_MUTED && playerState === 1) enableSound();
      } catch {
        /* the player also emits non-JSON chatter */
      }
    };
    window.addEventListener("message", state.onMessage);
  }

  /**
   * `scrollIntoView({ block: "center" })` degrades badly on the WebKit builds
   * that predate the options dictionary: the object reads as a truthy
   * `alignToTop`, so the card lands under the fixed header instead of mid
   * screen. Doing the arithmetic here keeps every engine on the same path.
   */
  function scrollToCard(card: HTMLElement) {
    const header = document.querySelector<HTMLElement>(".site-header");
    const clearance = (header?.offsetHeight ?? 0) + 16;
    const gap = Math.max((window.innerHeight - card.offsetHeight) / 2, clearance);
    const top = Math.max(window.scrollY + card.getBoundingClientRect().top - gap, 0);

    if ("scrollBehavior" in document.documentElement.style) {
      window.scrollTo({ top, behavior: "smooth" });
    } else {
      window.scrollTo(0, top);
    }
  }

  function showCover(state: CardState) {
    if (state.onMessage) {
      window.removeEventListener("message", state.onMessage);
      state.onMessage = null;
    }
    if (state.blockHomeJump) {
      document.removeEventListener("click", state.blockHomeJump, true);
      state.blockHomeJump = null;
    }
    state.media.innerHTML = state.coverHTML;
    state.actions.lastElementChild!.outerHTML = state.buttonHTML;
    state.card.classList.remove("egg-active");
    state.clicks = 0;
    bindVideoButton(state);
  }

  function bindVideoButton(state: CardState) {
    if (!state.realVideo) return;
    const button = state.actions.querySelector<HTMLButtonElement>(".js-play-video");
    button?.addEventListener("click", () =>
      mountPlayer(state, state.realVideo!, () => showCover(state)),
    );
  }

  function armEasterEgg(state: CardState, trigger: MouseEvent) {
    state.card.classList.add("egg-active");

    // The header logo sits inside <a href="#home">. That fragment navigation
    // is queued once this click finishes dispatching — i.e. *after* the scroll
    // below is asked for — so the browser ends up at the top of the page with
    // the smooth scroll cancelled. Registering the capture listener here is
    // too late for the click already in flight, hence killing it by hand.
    trigger.preventDefault();

    // The listener covers every later click while the egg runs. Capture phase,
    // so it beats the header's own handler. Released again in showCover().
    state.blockHomeJump = (event: MouseEvent) => {
      const link = (event.target as HTMLElement)?.closest?.('a[href="#home"]');
      if (link?.querySelector("[data-egg-trigger]")) {
        event.preventDefault();
        event.stopPropagation();
      }
    };
    document.addEventListener("click", state.blockHomeJump, true);

    mountPlayer(state, RICKROLL, () => showCover(state));

    const previous = state.actions.lastElementChild!;
    const stop = document.createElement("button");
    stop.type = "button";
    stop.className = "btn btn-danger";
    // Astro scopes component CSS with a data-astro-cid-* attribute. A node
    // built here has none, so no scoped .btn rule would reach it.
    for (const attr of previous.getAttributeNames()) {
      if (attr.startsWith("data-astro-cid-")) stop.setAttribute(attr, "");
    }
    // Sized inline for the same reason, plus the global `svg { height: auto }`
    // reset would otherwise collapse it to 0x0.
    stop.innerHTML =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" ' +
      'stroke-linecap="round" aria-hidden="true" ' +
      'style="width:20px;height:20px;flex-shrink:0">' +
      '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' +
      `<span>${state.cancelLabel}</span>`;
    stop.addEventListener("click", () => showCover(state));
    previous.replaceWith(stop);

    // Last, and a frame late: swapping the cover for a 16:9 iframe and the
    // button for a wider one resizes the card, so scrolling any earlier aims
    // at an offset that no longer exists by the time the scroll lands.
    requestAnimationFrame(() => scrollToCard(state.card));
  }

  function initProjects() {
    const grid = document.querySelector<HTMLElement>(".projects-grid");
    if (!grid || grid.dataset.bound) return;
    grid.dataset.bound = "true";

    grid.querySelectorAll<HTMLElement>(".project-card").forEach((card) => {
      const media = card.querySelector<HTMLElement>(".card-media");
      const actions = card.querySelector<HTMLElement>(".card-actions");
      if (!media || !actions) return;

      const state: CardState = {
        card,
        media,
        actions,
        coverHTML: media.innerHTML,
        buttonHTML: actions.lastElementChild!.outerHTML,
        realVideo: media.dataset.videoId || null,
        cancelLabel: grid.dataset.cancelEgg ?? "STOP Rickroll",
        unmuteLabel: grid.dataset.unmute ?? "Sound on",
        onMessage: null,
        blockHomeJump: null,
        clicks: 0,
      };

      bindVideoButton(state);

      // Both labels belong to nodes built in JS, so they miss the translator's
      // [data-translation-key] sweep and are retitled by hand. Registered for
      // every card: the sound button rides along with any video, not just the
      // egg.
      document.addEventListener("language-change", (event) => {
        const translations = (event as CustomEvent).detail?.translations ?? {};
        const relabel = (key: string, selector: string, current: string) => {
          const next = translations[key];
          if (!next) return current;
          const live = card.querySelector<HTMLElement>(selector);
          if (live) live.textContent = next;
          return next;
        };
        state.cancelLabel = relabel(
          "projects.cancelEgg",
          ".btn-danger span",
          state.cancelLabel,
        );
        state.unmuteLabel = relabel(
          "projects.unmute",
          ".sound-on span",
          state.unmuteLabel,
        );
      });

      // Only AMODEL carries the egg.
      if (card.dataset.project !== "amodel") return;

      document
        .querySelectorAll<HTMLElement>("[data-egg-trigger]")
        .forEach((logo) =>
          logo.addEventListener("click", (event) => {
            if (card.classList.contains("egg-active")) return;
            if (++state.clicks >= CLICKS_TO_ARM) armEasterEgg(state, event);
          }),
        );
    });
  }

  document.addEventListener("DOMContentLoaded", initProjects);
  document.addEventListener("astro:page-load", initProjects);
</script>

<style>
  .section-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .projects-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: var(--space-md);
  }

  .project-card {
    /* ~3 per row at container width, 2 on tablet, 1 on phone — always centred */
    flex: 1 1 320px;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(140%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(140%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  @media (hover: hover) {
    .project-card:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
      box-shadow: 0 18px 40px var(--color-shadow);
    }
  }

  .card-media {
    position: relative;
    background: #171717;
    overflow: hidden;
  }

  .card-media :global(iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  /* Built in JS, so it needs :global() to survive Astro's style scoping. */
  .card-media :global(.sound-on) {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-family: inherit;
    font-size: 0.8rem;
    line-height: 1;
    cursor: pointer;
    /* The YouTube chrome fades its own controls in around here; sitting above
       them at full opacity would bury the title bar. */
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  @media (hover: hover) {
    .card-media :global(.sound-on:hover) {
      background: rgba(0, 0, 0, 0.85);
      border-color: rgba(255, 255, 255, 0.6);
    }
  }

  .card-media :global(.cover),
  .card-media :global(iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 0;
  }




  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-sm);
    flex: 1;
  }

  .project-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .project-description {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
    flex: 1;
  }

  /* Compact horizontal chips. The old badges were vertical blocks with 40px
   * icons — six of them swallowed the card. */
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    list-style: none;
    margin: var(--space-3xs) 0 0;
    padding: 0;
  }

  .tech-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.6rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .tech-chip img {
    width: 16px;
    height: 16px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .card-actions {
    display: flex;
    gap: var(--space-3xs);
    margin-top: var(--space-2xs);
  }

  .btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
