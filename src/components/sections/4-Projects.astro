---
import { Image } from "astro:assets";
import kforgeCover from "../../assets/projects/kforge.webp";
import kappCover from "../../assets/projects/kapp.webp";
import amodelCover from "../../assets/projects/amodel.webp";
import spemCover from "../../assets/projects/spemtraductor.webp";
import portfolioCover from "../../assets/projects/myportfolio.webp";

const { t } = Astro.props;

/**
 * Project data lives here, not in the GitHub API.
 *
 * The previous version fetched every repo at build time. That made the build
 * depend on a token and on GitHub being reachable, and two slugs had gone
 * stale after the repos were renamed (KForge-Home -> K-Forge, K-APP -> KApp)
 * — it only kept working because GitHub was still 301-ing the old names.
 *
 * `video`: YouTube id. When set, the card renders a click-to-load player.
 *          Paste an id and it appears — nothing else to change.
 * `demo` : deployed URL, or null when there is none.
 */
const PROJECTS = [
  {
    id: "kapp",
    cover: kappCover,
    repo: "https://github.com/K-Forge/KApp",
    demo: "https://kapp-black.vercel.app",
    demoLabel: "projects.prototype", // front-end prototype, not a live product
    video: "",
    tech: [
      "Java",
      "Spring Boot",
      "Spring Cloud",
      "REST API Design",
      "PostgreSQL",
      "Docker",
      "Kotlin",
      "Swift",
      "Maven",
    ],
  },
  {
    // demo stays null on purpose: this one is a video walkthrough, not a site.
    // Paste the YouTube id into `video` and the card swaps the placeholder for
    // a click-to-load player and the button label for "Video".
    id: "amodel",
    cover: amodelCover,
    repo: "https://github.com/13rianVargas/A-Minecraft-Ordinary-Differential-Equation-Lab",
    demo: null,
    demoLabel: "projects.liveDemo",
    video: "", // ← paste the YouTube id here when the walkthrough is ready
    tech: [
      "Python",
      "NumPy",
      "SciPy",
      "pandas",
      "Matplotlib",
      "pytest",
      "Docker",
      "Linux CLI",
      "VPS",
      "Tailscale",
    ],
  },
  {
    id: "kforge",
    cover: kforgeCover,
    repo: "https://github.com/K-Forge/K-Forge",
    demo: "https://kforge.vercel.app",
    demoLabel: "projects.liveDemo",
    video: "",
    tech: [
      "Angular",
      "TypeScript",
      "Tailwind CSS",
      "HTML",
      "CSS",
      "Bun",
      "GitHub API",
      "Vercel",
    ],
  },
  {
    id: "spemtraductor",
    cover: spemCover,
    repo: "https://github.com/13rianVargas/SpemTraductor",
    demo: "https://spem-traductor.vercel.app",
    demoLabel: "projects.liveDemo",
    video: "",
    tech: ["JavaScript", "HTML", "CSS", "Vercel"],
  },
  {
    id: "myportfolio",
    cover: portfolioCover,
    repo: "https://github.com/13rianVargas/MyPortfolio",
    demo: "https://13rian-vargas.vercel.app",
    demoLabel: "projects.liveDemo",
    video: "",
    tech: [
      "Astro",
      "TypeScript",
      "HTML",
      "CSS",
      "pnpm",
      "CI/CD (GitHub Actions)",
      "Vercel",
    ],
  },
] as const;

const TECH_ICONS: Record<string, string> = {
  java: "java.svg",
  "spring boot": "spring.svg",
  "spring cloud": "spring.svg",
  "rest api design": "rest-api.svg",
  postgresql: "postgresql.svg",
  docker: "docker.svg",
  kotlin: "kotlin.svg",
  swift: "swift.svg",
  angular: "angular.svg",
  typescript: "typescript.svg",
  "tailwind css": "tailwind.svg",
  bun: "bun.svg",
  pnpm: "pnpm.svg",
  python: "python.svg",
  javascript: "javascript.svg",
  html: "html.svg",
  css: "css.svg",
  astro: "astro.svg",
  "github api": "/icons/github.svg",
  "ci/cd (github actions)": "github-actions.svg",
  vercel: "vercel.svg",
  maven: "maven.svg",
  numpy: "numpy.svg",
  scipy: "scipy.svg",
  pandas: "pandas.svg",
  matplotlib: "matplotlib.svg",
  pytest: "pytest.svg",
  "linux cli": "linux.svg",
  vps: "vps.svg",
  tailscale: "tailscale.svg",
  ssh: "ssh.svg",
};

// Not every tool ships an icon we have (NumPy, pytest, Vercel…). Those render
// as text-only chips rather than being dropped, so the stack stays honest.
function iconFor(tech: string): string | null {
  const file = TECH_ICONS[tech.toLowerCase()];
  if (!file) return null;
  return file.startsWith("/") ? file : `/icons/tech/${file}`;
}
---

<section id="projects" class="section-shell projects-section">
  <div class="section-container">
    <header class="section-header">
      <p class="section-eyebrow" data-translation-key="projects.eyebrow">
        {t("projects.eyebrow")}
      </p>
      <h2 class="section-title" data-translation-key="projects.title">
        {t("projects.title")}
      </h2>
      <p class="section-lead" data-translation-key="projects.description">
        {t("projects.description")}
      </p>
    </header>

    <div class="projects-grid">
      {
        PROJECTS.map((project) => (
          <article class="project-card" data-project={project.id}>
            <div class="card-media">
              {project.video ? (
                <button
                  class="video-facade"
                  data-video-id={project.video}
                  aria-label={t("projects.playVideo")}
                >
                  <img
                    src={`https://i.ytimg.com/vi/${project.video}/hqdefault.jpg`}
                    alt=""
                    width="480"
                    height="270"
                    loading="lazy"
                  />
                  <span class="play-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                </button>
              ) : (
                <Image
                  src={project.cover}
                  alt=""
                  widths={[400, 700]}
                  sizes="(min-width: 900px) 420px, 100vw"
                        loading="lazy"
                  class="cover"
                />
              )}
            </div>

            <div class="card-body">
              <h3
                class="project-title"
                data-translation-key={`projects.repo.${project.id}.title`}
              >
                {t(`projects.repo.${project.id}.title`)}
              </h3>

              <p
                class="project-description"
                data-translation-key={`projects.repo.${project.id}`}
              >
                {t(`projects.repo.${project.id}`)}
              </p>

              <ul class="tech-stack">
                {project.tech.map((tech) => {
                  const icon = iconFor(tech);
                  return (
                    <li class="tech-chip">
                      {icon && (
                        <img src={icon} alt="" width="16" height="16" loading="lazy" />
                      )}
                      <span>{tech}</span>
                    </li>
                  );
                })}
              </ul>

              <div class="card-actions">
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-ghost"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                  <span data-translation-key="projects.code">{t("projects.code")}</span>
                </a>

                {project.demo ? (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary"
                  >
                    <span data-translation-key={project.demoLabel}>
                      {t(project.demoLabel)}
                    </span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  </a>
                ) : project.video ? (
                  <button class="btn btn-primary js-scroll-video" type="button">
                    <img
                      src="/icons/youtube.svg"
                      alt=""
                      width="16"
                      height="16"
                      class="yt-icon"
                    />
                    <span data-translation-key="projects.watchDemo">
                      {t("projects.watchDemo")}
                    </span>
                  </button>
                ) : (
                  <span class="btn btn-disabled" aria-disabled="true">
                    <img
                      src="/icons/youtube.svg"
                      alt=""
                      width="16"
                      height="16"
                      class="yt-icon"
                    />
                    <span data-translation-key="projects.videoSoon">
                      {t("projects.videoSoon")}
                    </span>
                  </span>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script src="../../i18n/translator.ts"></script>

<script>
  /**
   * Click-to-load YouTube.
   *
   * A normal embed pulls ~700 KB of third-party JS on every page load even if
   * nobody presses play. The facade costs one thumbnail; the iframe is only
   * created on click.
   */
  function initVideoFacades() {
    document.querySelectorAll<HTMLButtonElement>(".video-facade").forEach((facade) => {
      if (facade.dataset.bound) return;
      facade.dataset.bound = "true";

      facade.addEventListener("click", () => {
        const id = facade.dataset.videoId;
        if (!id) return;

        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = facade.getAttribute("aria-label") ?? "Video";
        iframe.allow =
          "accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture";
        iframe.allowFullscreen = true;
        iframe.loading = "lazy";
        facade.replaceWith(iframe);
      });
    });

    document.querySelectorAll(".js-scroll-video").forEach((btn) => {
      btn.addEventListener("click", () => {
        const facade = btn
          .closest(".project-card")
          ?.querySelector<HTMLElement>(".video-facade");
        facade?.scrollIntoView({ block: "center" });
        facade?.click();
      });
    });
  }

  /**
   * ------------------------------------------------------------------
   * Easter egg: 13 clicks on the deer logo (13rian, naturally) rickrolls
   * the AMODEL card.
   *
   * It swaps the cover for an autoplaying embed and turns the disabled
   * "Video soon" placeholder into a working restore button. It restores
   * itself when the song ends, and it never touches `video` in the config —
   * so the day a real walkthrough is published, this steals nothing.
   * ------------------------------------------------------------------
   */
  const EGG = {
    clicksNeeded: 13,
    videoId: "dQw4w9WgXcQ",
    origin: "https://www.youtube-nocookie.com",
  };

  function initEasterEgg() {
    const card = document.querySelector<HTMLElement>('[data-project="amodel"]');
    if (!card || card.dataset.eggBound) return;
    card.dataset.eggBound = "true";

    const media = card.querySelector<HTMLElement>(".card-media");
    const actions = card.querySelector<HTMLElement>(".card-actions");
    if (!media || !actions) return;

    // Real video already configured? Then the egg has nothing to borrow.
    if (media.querySelector(".video-facade, iframe")) return;

    const originalMedia = media.innerHTML;
    const originalButton = actions.lastElementChild!.outerHTML;
    let clicks = 0;
    let onMessage: ((e: MessageEvent) => void) | null = null;

    function restore() {
      if (onMessage) {
        window.removeEventListener("message", onMessage);
        onMessage = null;
      }
      media!.innerHTML = originalMedia;
      actions!.lastElementChild!.outerHTML = originalButton;
      card!.classList.remove("egg-active");
      clicks = 0;
    }

    function trigger() {
      card!.classList.add("egg-active");
      card!.scrollIntoView({ behavior: "smooth", block: "center" });

      const frame = document.createElement("iframe");
      frame.src =
        `${EGG.origin}/embed/${EGG.videoId}` +
        `?autoplay=1&rel=0&enablejsapi=1&origin=${encodeURIComponent(location.origin)}`;
      frame.title = "Never Gonna Give You Up";
      frame.allow = "autoplay; encrypted-media; picture-in-picture";
      frame.allowFullscreen = true;
      media!.replaceChildren(frame);

      // Swap the dead placeholder for a real button that undoes this.
      const stop = document.createElement("button");
      stop.type = "button";
      stop.className = "btn btn-primary";
      stop.innerHTML =
        '<img src="/icons/youtube.svg" alt="" width="16" height="16" class="yt-icon" /><span>Never gonna give you up</span>';
      stop.addEventListener("click", restore);
      actions!.lastElementChild!.replaceWith(stop);

      // Ask the player to report state changes, then restore when it ends.
      // Using postMessage directly avoids pulling in the YouTube iframe API.
      frame.addEventListener("load", () => {
        frame.contentWindow?.postMessage(
          JSON.stringify({ event: "listening", id: 1, channel: "widget" }),
          EGG.origin,
        );
      });

      onMessage = (event: MessageEvent) => {
        // Only trust the player's own origin.
        if (event.origin !== EGG.origin) return;
        try {
          const data = JSON.parse(event.data);
          // 0 === ENDED
          if (data?.info?.playerState === 0) restore();
        } catch {
          /* the player also emits non-JSON chatter; ignore it */
        }
      };
      window.addEventListener("message", onMessage);
    }

    document.querySelectorAll<HTMLElement>("[data-egg-trigger]").forEach((logo) => {
      logo.addEventListener("click", () => {
        if (card.classList.contains("egg-active")) return;
        if (++clicks >= EGG.clicksNeeded) trigger();
      });
    });
  }

  function initProjects() {
    initVideoFacades();
    initEasterEgg();
  }

  document.addEventListener("DOMContentLoaded", initProjects);
  document.addEventListener("astro:page-load", initProjects);
</script>

<style>
  .section-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .projects-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: var(--space-md);
  }

  .project-card {
    /* ~3 per row at container width, 2 on tablet, 1 on phone — always centred */
    flex: 1 1 320px;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(140%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(140%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  @media (hover: hover) {
    .project-card:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
      box-shadow: 0 18px 40px var(--color-shadow);
    }
  }

  .card-media {
    position: relative;
    background: #171717;
    overflow: hidden;
  }

  .card-media :global(iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  .card-media :global(.cover),
  .card-media :global(iframe),
  .video-facade img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 0;
  }

  .video-facade {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
  }

  .play-badge {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 62px;
    height: 62px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    transition: transform var(--transition-fast);
  }

  .video-facade:hover .play-badge {
    transform: scale(1.1);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-sm);
    flex: 1;
  }

  .project-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .project-description {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
    flex: 1;
  }

  /* Compact horizontal chips. The old badges were vertical blocks with 40px
   * icons — six of them swallowed the card. */
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    list-style: none;
    margin: var(--space-3xs) 0 0;
    padding: 0;
  }

  .tech-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.6rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .tech-chip img {
    width: 16px;
    height: 16px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .card-actions {
    display: flex;
    gap: var(--space-3xs);
    margin-top: var(--space-2xs);
  }

  .btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 700;
    white-space: nowrap;
    transition:
      transform var(--transition-fast),
      background var(--transition-fast),
      border-color var(--transition-fast);
  }

  /* Dark text on amber: 10.4:1. The old white-on-amber measured 1.67:1. */
  .btn-primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
    border: 1px solid transparent;
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
  }

  .btn-ghost:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .btn-disabled {
    background: transparent;
    color: var(--color-text-secondary);
    border: 1px dashed var(--color-border);
    cursor: default;
    font-weight: 600;
    font-size: var(--text-xs);
    min-width: 0;
  }

  .yt-icon {
    flex-shrink: 0;
    opacity: 0.85;
  }

  .btn-primary .yt-icon {
    opacity: 1;
  }

  /* Buttons may shrink but must never squeeze a sibling out of the row —
     the long "video" label used to overlap the GitHub button. */
  .btn > span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
