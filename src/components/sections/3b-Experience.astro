---
const { t } = Astro.props;

/**
 * Mirrors the EXPERIENCE block of the CV, in the same order.
 *
 * The file is `3b-` rather than a whole renumbering of the sections: this
 * belongs between AboutMe (3) and Projects (4), and shifting five other files
 * plus their imports to buy a tidier number is churn with no benefit.
 *
 * Roles only. The CV files KApp and AMODEL under "Experience and projects"
 * because one page cannot afford two headings; the site has both sections, so
 * they stay in Projects and are not repeated here.
 */
/**
 * `icon` is external artwork; `inline` is drawn here on purpose. An external SVG
 * loaded through <img> is an isolated document, so `currentColor` never reaches
 * it and it cannot follow the light/dark toggle — the teaching mark rendered
 * black on a near-black disc until it was inlined.
 */
const ROLES = [
  { key: "kforge", icon: "/icons/orgs/k-forge.png", current: true, fill: true },
  { key: "assistant", icon: null, current: false, fill: false },
] as const;

---

<section id="experience" class="section-shell">
  <div class="section-container">
    <header class="section-header">
      <p class="section-eyebrow" data-translation-key="experience.eyebrow">
        {t("experience.eyebrow")}
      </p>
      <h2 class="section-title" data-translation-key="experience.title">
        {t("experience.title")}
      </h2>
      <p class="section-lead" data-translation-key="experience.description">
        {t("experience.description")}
      </p>
    </header>

    <ol class="timeline">
      {
        ROLES.map((role) => (
          <li class="entry">
            <div class:list={["marker", { fill: role.fill }]} aria-hidden="true">
              {role.icon ? (
                <img src={role.icon} alt="" width="24" height="24" loading="lazy" />
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
                  <rect x="11" y="1.8" width="11.4" height="8.4" rx="1.2" />
                  <path d="M14 5h6M14 7.6h3.6" stroke-opacity="0.5" />
                  <circle cx="5" cy="4.6" r="2.3" />
                  <path d="M1.7 13.4v-2.6A3.3 3.3 0 0 1 5 7.5a3.3 3.3 0 0 1 3.1 2.2" />
                  <path d="m7.6 8.9 3.1-2.6" stroke-opacity="0.85" />
                  <circle cx="12.4" cy="15.9" r="2.6" />
                  <path d="M8 22.4v-1.5a4.4 4.4 0 0 1 4.4-4.4 4.4 4.4 0 0 1 4.4 4.4v1.5" />
                </svg>
              )}
            </div>

            <div class="content">
              <div class="head">
                <h3
                  class="entry-title"
                  data-translation-key={`experience.${role.key}.title`}
                >
                  {t(`experience.${role.key}.title`)}
                </h3>
                <span
                  class:list={["date", { now: role.current }]}
                  data-translation-key={`experience.${role.key}.date`}
                >
                  {t(`experience.${role.key}.date`)}
                </span>
              </div>

              <p class="org" data-translation-key={`experience.${role.key}.org`}>
                {t(`experience.${role.key}.org`)}
              </p>

              <p class="desc" data-translation-key={`experience.${role.key}.desc`}>
                {t(`experience.${role.key}.desc`)}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script src="../../i18n/translator.ts"></script>

<style>
  .section-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .timeline {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 860px;
    position: relative;
  }

  /* Rail sits behind the markers and stops at the last one. */
  .timeline::before {
    content: "";
    position: absolute;
    left: 23px;
    top: 24px;
    bottom: 24px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--color-accent),
      var(--color-border)
    );
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--space-sm);
    padding-bottom: var(--space-md);
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  .marker {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--color-bg-primary);
    border: 2px solid var(--color-border);
    color: var(--color-accent-text);
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }

  .marker img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  /* The K-Forge mark is full-bleed artwork; it fills the disc rather than
     sitting as a small square inside it. */
  .marker.fill {
    overflow: hidden;
  }

  .marker.fill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-full);
  }

  .content {
    padding-top: 0.35rem;
    min-width: 0;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3xs);
  }

  .entry-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .date {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    background: color-mix(in srgb, var(--color-text-primary) 7%, transparent);
    border-radius: var(--radius-full);
    padding: 0.2rem 0.65rem;
    white-space: nowrap;
  }

  /* Ongoing roles carry the accent so the current work reads first. */
  .date.now {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .org {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent-text);
    margin: 0.2rem 0 0;
  }

  .desc {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: var(--space-3xs) 0 0;
  }

  @media (max-width: 560px) {
    .timeline::before {
      left: 17px;
    }
    .entry {
      grid-template-columns: 36px 1fr;
      gap: var(--space-2xs);
    }
    .marker {
      width: 36px;
      height: 36px;
    }
    .marker img {
      width: 19px;
      height: 19px;
    }
  }
</style>
