---
const { t } = Astro.props;

// Number lives in the href only — never rendered as text, so there is nothing
// on the page for an address scraper to pick up.
const WHATSAPP = "https://wa.me/573212256970";

/**
 * FormSubmit endpoint, assembled from parts at runtime.
 *
 * The form posts from the browser because FormSubmit sits behind Cloudflare
 * and answers datacenter IPs with a 403 challenge — a server route could not
 * deliver from Vercel. That means the address is reachable from the page, so
 * it is split here instead of sitting in the markup as one literal string.
 *
 * To be clear: this is friction, not protection. It defeats a regex sweeping
 * the HTML for addresses; it does not defeat anyone who reads the script.
 */
const INBOX = ["brians.vargasc", "gmail.com"];
---

<section id="contactme" class="section-shell">
  <div class="section-container contact-layout">
    <header class="section-header">
      <p class="section-eyebrow" data-translation-key="contactme.eyebrow">
        {t("contactme.eyebrow")}
      </p>
      <h2 class="section-title" data-translation-key="contactme.title">
        {t("contactme.title")}
      </h2>
      <p class="section-lead" data-translation-key="contactme.description">
        {t("contactme.description")}
      </p>
    </header>

    <div class="glass-panel contact-card">
      <form
        class="contact-form"
        id="contact-form"
        novalidate
        data-inbox-user={INBOX[0]}
        data-inbox-host={INBOX[1]}
      >
        <div class="field">
          <label for="name" data-translation-key="contactme.name">
            {t("contactme.name")}
          </label>
          <input
            type="text"
            id="name"
            name="name"
            autocomplete="name"
            required
            minlength="2"
            maxlength="100"
            placeholder={t("contactme.namePlaceholder")}
            data-translation-key-placeholder="contactme.namePlaceholder"
          />
        </div>

        <div class="field">
          <label for="email" data-translation-key="contactme.email">
            {t("contactme.email")}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            maxlength="254"
            placeholder={t("contactme.emailPlaceholder")}
            data-translation-key-placeholder="contactme.emailPlaceholder"
          />
        </div>

        <div class="field">
          <label for="message" data-translation-key="contactme.message">
            {t("contactme.message")}
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            minlength="10"
            maxlength="500"
            placeholder={t("contactme.messagePlaceholder")}
            data-translation-key-placeholder="contactme.messagePlaceholder"></textarea>
          <p class="counter"><span id="char-count">0</span>/500</p>
        </div>

        <div class="botcheck" aria-hidden="true">
          <label for="botcheck">Leave this field empty</label>
          <input
            type="text"
            id="botcheck"
            name="botcheck"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <button type="submit" class="submit-btn" id="submit-btn">
          <span class="btn-text" data-translation-key="contactme.send">
            {t("contactme.send")}
          </span>
          <svg
            class="btn-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          <span class="loader" hidden></span>
        </button>

        <p class="form-status" id="form-status" role="status" aria-live="polite">
        </p>
      </form>

      <div class="direct">
        <p class="direct-label" data-translation-key="contactme.orReachMe">
          {t("contactme.orReachMe")}
        </p>
        <div class="direct-links">
          <a
            href={WHATSAPP}
            target="_blank"
            rel="noopener noreferrer"
            class="chip whatsapp"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23z" />
              <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z" />
            </svg>
            <span data-translation-key="contactme.whatsapp"
              >{t("contactme.whatsapp")}</span
            >
          </a>
          <a
            href="https://www.linkedin.com/in/13rian-vargas/"
            target="_blank"
            rel="noopener noreferrer"
            class="chip linkedin"
          >
            <img src="/icons/linkedin.svg" alt="" width="20" height="20" />
            <span>LinkedIn</span>
          </a>
          <a
            href="https://github.com/13rianVargas"
            target="_blank"
            rel="noopener noreferrer"
            class="chip github"
          >
            <img src="/icons/github.svg" alt="" width="20" height="20" />
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="../../i18n/translator.ts"></script>

<script>
  /**
   * Posts straight to FormSubmit. See the note in the frontmatter for why this
   * is not routed through a server function.
   */
  interface Messages {
    success: string;
    error: string;
    sending: string;
    required: string;
    emailInvalid: string;
    tooShort: string;
    rateLimited: string;
    send: string;
  }

  function initContactForm() {
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "true";

    const message = document.getElementById("message") as HTMLTextAreaElement;
    const counter = document.getElementById("char-count") as HTMLElement;
    const submit = document.getElementById("submit-btn") as HTMLButtonElement;
    const status = document.getElementById("form-status") as HTMLElement;
    const label = submit.querySelector(".btn-text") as HTMLElement;
    const icon = submit.querySelector(".btn-icon") as SVGElement;
    const loader = submit.querySelector(".loader") as HTMLElement;

    let msgs: Messages = {
      success: "Message sent.",
      error: "Could not send. Please try again in a moment.",
      sending: "Sending...",
      required: "All fields are required.",
      emailInvalid: "Please enter a valid email.",
      tooShort: "Your message needs at least 10 characters.",
      rateLimited: "Too many attempts. Wait a minute and try again.",
      send: label.textContent?.trim() || "Send",
    };

    document.addEventListener("language-change", (event) => {
      const { translations } = (event as CustomEvent).detail ?? {};
      if (!translations) return;
      msgs = {
        success: translations["contactme.success"] ?? msgs.success,
        error: translations["contactme.error"] ?? msgs.error,
        sending: translations["contactme.sending"] ?? msgs.sending,
        required: translations["contactme.required"] ?? msgs.required,
        emailInvalid:
          translations["contactme.emailInvalid"] ?? msgs.emailInvalid,
        tooShort: translations["contactme.tooShort"] ?? msgs.tooShort,
        rateLimited: translations["contactme.rateLimited"] ?? msgs.rateLimited,
        send: translations["contactme.send"] ?? msgs.send,
      };
    });

    message.addEventListener("input", () => {
      counter.textContent = String(message.value.length);
      counter.classList.toggle("at-limit", message.value.length >= 500);
    });

    function setStatus(text: string, kind: "success" | "error" | "") {
      status.textContent = text;
      status.className = `form-status${kind ? ` is-${kind}` : ""}`;
    }

    function setLoading(loading: boolean) {
      submit.disabled = loading;
      label.textContent = loading ? msgs.sending : msgs.send;
      icon.style.display = loading ? "none" : "";
      loader.hidden = !loading;
    }


    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const name = String(data.get("name") ?? "").trim();
      const email = String(data.get("email") ?? "").trim();
      const body = String(data.get("message") ?? "").trim();

      if (!name || !email || !body) return setStatus(msgs.required, "error");
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email))
        return setStatus(msgs.emailInvalid, "error");
      if (body.length < 10) return setStatus(msgs.tooShort, "error");

      setLoading(true);
      setStatus("", "");

      try {
        // A filled honeypot means a bot: answer as if it worked and send
        // nothing, so it gets no signal that it was caught.
        if (String(data.get("botcheck") ?? "").trim() !== "") {
          setStatus(msgs.success, "success");
          form.reset();
          counter.textContent = "0";
          return;
        }

        const inbox = `${form.dataset.inboxUser}@${form.dataset.inboxHost}`;
        const response = await fetch(
          `https://formsubmit.co/ajax/${encodeURIComponent(inbox)}`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify({
              name,
              email,
              message: body,
              _subject: `Portfolio — nuevo mensaje de ${name}`,
              _template: "table",
              _captcha: "false",
            }),
          },
        );

        const result = await response.json().catch(() => ({ success: false }));

        if (response.ok && (result.success === "true" || result.success === true)) {
          setStatus(msgs.success, "success");
          form.reset();
          counter.textContent = "0";
        } else {
          setStatus(msgs.error, "error");
        }
      } catch {
        setStatus(msgs.error, "error");
      } finally {
        setLoading(false);
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initContactForm);
  document.addEventListener("astro:page-load", initContactForm);
</script>

<style>
  .contact-layout {
    max-width: 720px;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-card {
    padding: var(--space-md);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-secondary);
    padding-left: 0.35rem;
  }

  .field:focus-within label {
    color: var(--color-accent-text);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-bg-primary);
    color: var(--color-text-primary);
    font-size: var(--text-base);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  /* --color-accent-rgb used to be undefined, which made this shadow invalid
   * and silently dropped: the fields had no focus ring at all. */
  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 4px rgba(var(--color-accent-rgb), 0.28);
  }

  .counter {
    align-self: flex-end;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0;
    padding-right: 0.35rem;
  }

  .counter :global(.at-limit) {
    color: var(--color-error);
    font-weight: 700;
  }

  .botcheck {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .submit-btn {
    margin-top: var(--space-3xs);
    padding: 0.8rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-on-accent); /* 10.4:1 — was white on amber at 1.67:1 */
    font-size: var(--text-base);
    font-weight: 800;
    transition:
      background var(--transition-fast),
      transform var(--transition-fast);
  }

  .submit-btn:hover:not(:disabled) {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .submit-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .loader {
    width: 18px;
    height: 18px;
    border: 2px solid currentColor;
    border-bottom-color: transparent;
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .form-status {
    margin: 0;
    min-height: 1.4em;
    font-size: var(--text-sm);
    font-weight: 600;
    text-align: center;
  }

  .form-status.is-success {
    color: var(--color-success);
  }

  .form-status.is-error {
    color: var(--color-error);
  }

  .direct {
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .direct-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-2xs);
  }

  .direct-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-bg-primary);
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    transition:
      transform var(--transition-fast),
      background var(--transition-fast),
      border-color var(--transition-fast);
  }

  .chip:hover {
    transform: translateY(-3px);
  }

  .chip.whatsapp:hover {
    background: #25d366;
    border-color: #25d366;
    color: #0b2e18;
  }

  .chip.linkedin:hover {
    background: #0a66c2;
    border-color: #0a66c2;
    color: #fff;
  }

  .chip.github:hover {
    background: #171717;
    border-color: #171717;
    color: #fff;
  }

  .chip img {
    width: 20px;
    height: 20px;
  }

  :global(.dark) .chip img {
    filter: brightness(0) invert(1);
  }

  .chip.linkedin:hover img,
  .chip.github:hover img {
    filter: brightness(0) invert(1);
  }
</style>
