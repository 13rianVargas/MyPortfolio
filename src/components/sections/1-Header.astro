---
import ThemeToggleButton from "../tools/ThemeToggleButton.astro";
import LanguageSelect from "../tools/LanguageSelect.astro";
import Logo from "../tools/Logo.astro";

const { t } = Astro.props;

// Single source of truth for the nav. The client script derives its section
// list from the rendered DOM instead of keeping a second hardcoded copy, so
// the two can no longer drift apart.
const NAV_SECTIONS = [
  { id: "home", labelKey: "layout.home" },
  { id: "aboutme", labelKey: "layout.about" },
  { id: "projects", labelKey: "layout.projects" },
  { id: "technologies", labelKey: "layout.technologies" },
  { id: "credentials", labelKey: "layout.credentials" },
  { id: "awards", labelKey: "layout.awards" },
  { id: "contactme", labelKey: "layout.contact" },
] as const;
---

<header class="site-header">
  <div class="header-bar">
    <div class="shine-container" aria-hidden="true">
      <div class="shine-effect"></div>
    </div>

    <div class="header-inner">
      <a href="#home" class="brand" aria-label="Brian Vargas — home">
        <Logo size="2.6rem" />
        <span class="brand-name">13rian</span>
      </a>

      <nav class="header-nav" id="headerNav" aria-label="Main">
        <div class="nav-oval-indicator" id="navOvalIndicator" aria-hidden="true">
        </div>
        <ul>
          {
            NAV_SECTIONS.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="nav-link"
                  data-section={section.id}
                  data-translation-key={section.labelKey}
                >
                  {t(section.labelKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-actions">
        <button
          class="mobile-menu-button"
          id="mobileMenuButton"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobileMenu"
          type="button"
        >
          <span class="hamburger" id="hamburger" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
        </button>
        <LanguageSelect />
        <ThemeToggleButton />
      </div>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu">
  <ul>
    {
      NAV_SECTIONS.map((section, index) => (
        <li>
          <a
            href={`#${section.id}`}
            class="nav-link"
            data-section={section.id}
            data-translation-key={section.labelKey}
            style={`--i: ${index}`}
          >
            {t(section.labelKey)}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script src="../../i18n/translator.ts"></script>

<script>
  // Sections are read from the DOM, so adding a nav item in the frontmatter is
  // the only edit needed — no parallel array to keep in sync.
  const SECTIONS = [
    ...new Set(
      [...document.querySelectorAll<HTMLElement>("[data-section]")].map(
        (el) => el.dataset.section!,
      ),
    ),
  ];

  const state = {
    current: "",
    clickScrolling: false,
    scrollTimer: 0,
  };

  const $ = <T extends HTMLElement>(sel: string) =>
    document.querySelector<T>(sel);
  const $$ = <T extends HTMLElement>(sel: string) =>
    document.querySelectorAll<T>(sel);

  function currentSection(): string {
    const probe = window.scrollY + window.innerHeight * 0.3;
    for (const id of [...SECTIONS].reverse()) {
      const el = document.getElementById(id);
      if (el && el.offsetTop <= probe) return id;
    }
    return SECTIONS[0] ?? "home";
  }

  function setActive(id: string) {
    $$(".nav-link").forEach((link) =>
      link.classList.toggle("nav-link-active", link.dataset.section === id),
    );
  }

  function moveOval(id: string) {
    const oval = $("#navOvalIndicator");
    const link = $<HTMLAnchorElement>(`.header-nav a[data-section="${id}"]`);
    const nav = $(".header-nav");
    if (!oval || !link || !nav) return;

    const navBox = nav.getBoundingClientRect();
    const linkBox = link.getBoundingClientRect();
    oval.style.width = `${linkBox.width}px`;
    oval.style.transform = `translateY(-50%) translateX(${linkBox.left - navBox.left}px)`;
    oval.classList.add("active");
  }

  function sync(id: string) {
    setActive(id);
    moveOval(id);
    state.current = id;
  }

  function toggleMenu(force?: boolean) {
    const menu = $("#mobileMenu");
    const burger = $("#hamburger");
    const button = $("#mobileMenuButton");
    const bar = $(".header-bar");
    if (!menu || !burger || !button || !bar) return;

    const open = force ?? !menu.classList.contains("active");
    menu.classList.toggle("active", open);
    burger.classList.toggle("active", open);
    bar.classList.toggle("menu-active", open);
    button.setAttribute("aria-expanded", String(open));
  }

  function init() {
    $("#mobileMenuButton")?.addEventListener("click", () => toggleMenu());

    $$<HTMLAnchorElement>("a[data-section]").forEach((link) => {
      link.addEventListener("click", (event) => {
        const id = link.dataset.section;
        const target = id && document.getElementById(id);
        if (!id || !target) return; // let the plain #hash href do its job

        event.preventDefault();
        state.clickScrolling = true;
        window.clearTimeout(state.scrollTimer);

        target.scrollIntoView({ behavior: "smooth" });
        history.pushState(null, "", `#${id}`);
        sync(id);
        toggleMenu(false);

        state.scrollTimer = window.setTimeout(() => {
          state.clickScrolling = false;
        }, 900);
      });
    });

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (state.clickScrolling || ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const next = currentSection();
          if (next !== state.current) sync(next);
          ticking = false;
        });
      },
      { passive: true },
    );

    window.addEventListener("resize", () => moveOval(state.current));
    document.addEventListener("language-change", () =>
      window.setTimeout(() => moveOval(state.current), 60),
    );

    document.addEventListener("click", (event) => {
      const menu = $("#mobileMenu");
      if (!menu?.classList.contains("active")) return;
      const target = event.target as Node;
      if (!menu.contains(target) && !$(".site-header")?.contains(target)) {
        toggleMenu(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") toggleMenu(false);
    });

    const initial =
      (location.hash.slice(1) && SECTIONS.includes(location.hash.slice(1))
        ? location.hash.slice(1)
        : null) ?? currentSection();

    const oval = $("#navOvalIndicator");
    if (oval) oval.style.transition = "none";
    sync(initial);
    oval?.offsetHeight; // force reflow before restoring the transition
    if (oval) oval.style.transition = "";

    // The first measurement happens before the display webfont has swapped in,
    // so the link boxes still have fallback-font widths and the pill lands off
    // to the side. Re-measure once the real metrics are known.
    const remeasure = () => moveOval(state.current);
    document.fonts?.ready.then(remeasure).catch(() => {});
    window.addEventListener("load", remeasure, { once: true });
  }

  document.addEventListener("DOMContentLoaded", init);
</script>

<style>
  .site-header {
    /* No background here on purpose — the bar has to stay glass, and any
       colour on this element both makes it opaque and flips Safari's top
       band to dark chrome in either theme (reproduced with a plain hex, so
       it is not the color-mix).
     *
     * Instead it steps off the top edge by the gap the bar used to carry as
     * its own margin, so it no longer counts as the element flush with that
     * edge. That leaves .chrome-tint-top as the one Safari samples for the
     * status-bar band. The bar itself does not move: the margin below moved
     * up here. */
    position: fixed;
    top: clamp(0.25rem, 1vw, 0.5rem);
    left: 0;
    width: 100%;
    z-index: var(--z-header);
    display: flex;
    justify-content: center;
    pointer-events: none;
    /* The page now runs edge to edge (viewport-fit=cover), so the bar has to
       step around the notch itself — in landscape that lands on its side. */
    padding: env(safe-area-inset-top) env(safe-area-inset-right) 0
      env(safe-area-inset-left);
  }

  .header-bar {
    pointer-events: auto;
    position: relative;
    /* 100% of the padded header, not 100vw: the viewport unit ignores both the
       safe-area padding above and the desktop scrollbar. */
    width: min(100% - clamp(0.5rem, 2vw, 2rem), 1400px);
    /* the gap moved to .site-header's top offset — see the note there */
    padding: clamp(0.5rem, 1.5vw, 0.8rem) clamp(0.75rem, 2vw, 1.5rem);
    border-radius: clamp(20px, 5vw, 50px);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    transition: border-radius var(--transition-base);
  }

  .header-bar.menu-active {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-color: transparent;
  }

  .shine-container {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
  }

  .shine-effect {
    position: absolute;
    inset: -50%;
    background: linear-gradient(
      to bottom right,
      transparent 45%,
      rgba(255, 255, 255, 0.18) 50%,
      transparent 55%
    );
    transform: rotate(45deg) translate(-100%, -100%);
  }

  /* Was an infinite 10s loop repainting a full-bleed gradient forever.
   * Now it only sweeps when the header is actually hovered. */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .header-bar:hover .shine-effect {
      animation: shine 1.6s var(--ease-out);
    }
  }

  @keyframes shine {
    from {
      transform: rotate(45deg) translate(-100%, -100%);
    }
    to {
      transform: rotate(45deg) translate(100%, 100%);
    }
  }

  .header-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(0.5rem, 2vw, 1rem);
    min-height: 2.6rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .header-nav {
    position: relative;
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .header-nav ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    z-index: 2;
    display: block;
    padding: 0.4rem clamp(0.5rem, 1.1vw, 0.9rem);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-accent-text);
  }

  .nav-link-active {
    color: var(--color-accent-text);
    font-weight: 700;
  }

  .nav-oval-indicator {
    position: absolute;
    top: 50%;
    left: 0;
    height: 2.05rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-accent) 26%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    transform: translateY(-50%);
    transform-origin: left center;
    opacity: 0;
    pointer-events: none;
    z-index: 1;
    transition:
      transform 0.45s var(--ease-spring),
      width 0.45s var(--ease-spring),
      opacity var(--transition-fast);
  }

  .nav-oval-indicator.active {
    opacity: 1;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .mobile-menu-button {
    display: flex;
    align-items: center;
    padding: 0.35rem;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 22px;
    height: 16px;
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--color-text-primary);
    transform-origin: center;
    transition: transform var(--transition-base), opacity var(--transition-fast);
  }

  .hamburger.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }
  .hamburger.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---------------- Mobile menu ---------------- */

  .mobile-menu {
    position: fixed;
    top: calc(
      clamp(0.25rem, 1vw, 0.5rem) + var(--header-height) +
        env(safe-area-inset-top)
    );
    left: 50%;
    /* Hangs off the header, so it repeats the bar's width — minus the notch,
       which this one has to subtract by hand: it is positioned, not padded. */
    width: min(
      100vw - clamp(0.5rem, 2vw, 2rem) - env(safe-area-inset-left) -
        env(safe-area-inset-right),
      1400px
    );
    z-index: var(--z-mobile-menu);
    padding: var(--space-sm) var(--space-xs) var(--space-xs);
    border-radius: 0 0 clamp(20px, 5vw, 40px) clamp(20px, 5vw, 40px);
    background: var(--glass-bg-strong);
    backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    border: 1px solid var(--glass-border);
    border-top: none;
    box-shadow: var(--glass-shadow);
    max-height: calc(100dvh - var(--header-height) - 2rem);
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-50%) translateY(-12px);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base),
      visibility var(--transition-base);
  }

  .mobile-menu.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu .nav-link {
    padding: 0.7rem 1rem;
    text-align: center;
    font-size: var(--text-lg);
    font-weight: 700;
    border: 1px solid transparent;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base),
      background var(--transition-fast);
  }

  .mobile-menu.active .nav-link {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--i, 0) * 0.04s + 0.06s);
  }

  .mobile-menu .nav-link-active,
  .mobile-menu .nav-link:hover {
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  /* ---------------- Breakpoints ---------------- */

  /* Seven items need room; below this the hamburger takes over. */
  @media (max-width: 1150px) {
    .header-nav {
      display: none;
    }
  }

  @media (min-width: 1151px) {
    .mobile-menu-button,
    .mobile-menu {
      display: none;
    }
  }

  @media (min-width: 1151px) and (max-width: 1320px) {
    .nav-link {
      padding-inline: 0.55rem;
      font-size: var(--text-xs);
    }
  }
</style>
