---
const { t } = Astro.props;

/**
 * Everything here is on the CV with a verifiable issuer. `highlight` is
 * reserved for the CCST: an official proctored Cisco exam passed with
 * 974/1000, which is the strongest single credential on the list.
 */
const ITEMS = [
  { key: "ccst", icon: "/icons/tech/cybersecurity.svg", highlight: true },
  { key: "cisco", icon: "/icons/tech/cisco.svg", highlight: false },
  { key: "gcp", icon: "/icons/tech/google-cloud.svg", highlight: false },
  { key: "platzi", icon: "/icons/tech/spring.svg", highlight: false },
  { key: "degree", icon: null, highlight: false },
  { key: "ilt", icon: null, highlight: false },
  { key: "one", icon: "/icons/tech/oracle.svg", highlight: false },
] as const;
---

<section id="credentials" class="section-shell">
  <div class="section-container">
    <header class="section-header">
      <p class="section-eyebrow" data-translation-key="credentials.eyebrow">
        {t("credentials.eyebrow")}
      </p>
      <h2 class="section-title" data-translation-key="credentials.title">
        {t("credentials.title")}
      </h2>
      <p class="section-lead" data-translation-key="credentials.description">
        {t("credentials.description")}
      </p>
    </header>

    <ol class="timeline">
      {
        ITEMS.map((item) => (
          <li class:list={["entry", { highlight: item.highlight }]}>
            <div class="marker" aria-hidden="true">
              {item.icon ? (
                <img src={item.icon} alt="" width="22" height="22" loading="lazy" />
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                  <path d="M6 12v5c3 3 9 3 12 0v-5" />
                </svg>
              )}
            </div>

            <div class="content">
              <div class="head">
                <h3
                  class="entry-title"
                  data-translation-key={`credentials.${item.key}.title`}
                >
                  {t(`credentials.${item.key}.title`)}
                </h3>
                <span
                  class="date"
                  data-translation-key={`credentials.${item.key}.date`}
                >
                  {t(`credentials.${item.key}.date`)}
                </span>
              </div>

              <p class="org" data-translation-key={`credentials.${item.key}.org`}>
                {t(`credentials.${item.key}.org`)}
              </p>

              {item.highlight && (
                <span class="badge" data-translation-key="credentials.highlight">
                  {t("credentials.highlight")}
                </span>
              )}

              <p class="desc" data-translation-key={`credentials.${item.key}.desc`}>
                {t(`credentials.${item.key}.desc`)}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script src="../../i18n/translator.ts"></script>

<style>
  .section-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .timeline {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 860px;
    position: relative;
  }

  /* The rail sits behind the markers and stops at the last one. */
  .timeline::before {
    content: "";
    position: absolute;
    left: 23px;
    top: 24px;
    bottom: 24px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--color-accent),
      var(--color-border)
    );
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--space-sm);
    padding-bottom: var(--space-md);
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  .marker {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--color-bg-primary);
    border: 2px solid var(--color-border);
    color: var(--color-text-secondary);
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }

  .entry.highlight .marker {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 4px
      color-mix(in srgb, var(--color-accent) 22%, transparent);
  }

  .marker img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .content {
    padding-top: 0.35rem;
    min-width: 0;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3xs);
  }

  .entry-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .date {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    background: color-mix(in srgb, var(--color-text-primary) 7%, transparent);
    border-radius: var(--radius-full);
    padding: 0.2rem 0.65rem;
    white-space: nowrap;
  }

  .org {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent-text);
    margin: 0.2rem 0 0;
  }

  .badge {
    display: inline-block;
    margin-top: var(--space-3xs);
    padding: 0.15rem 0.6rem;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-full);
  }

  .desc {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: var(--space-3xs) 0 0;
  }

  @media (max-width: 560px) {
    .timeline::before {
      left: 17px;
    }
    .entry {
      grid-template-columns: 36px 1fr;
      gap: var(--space-2xs);
    }
    .marker {
      width: 36px;
      height: 36px;
    }
    .marker img {
      width: 18px;
      height: 18px;
    }
  }
</style>
