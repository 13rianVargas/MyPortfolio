---
import { Image } from "astro:assets";
import profilePhoto from "../../assets/BrianPhoto.webp";

const { t } = Astro.props;

const START_YEAR = 2023;
const yearsOfExperience = new Date().getFullYear() - START_YEAR;

/**
 * Counts are derived from the CV so the two never disagree:
 *  - technologies : 31 entries listed in 5-Technologies.astro
 *  - certificates : Cisco 5 + Google Cloud 16 + Platzi 2 + ILT 1 + ONE 1
 */
const STATS = [
  { value: `${yearsOfExperience}+`, labelKey: "aboutme.experience" },
  { value: "31", labelKey: "aboutme.technologies" },
  { value: "25", labelKey: "aboutme.certifications" },
] as const;

const SKILLS = [
  "aboutme.skill.leadership",
  "aboutme.skill.problemSolving",
  "aboutme.skill.communication",
  "aboutme.skill.proactivity",
  "aboutme.skill.responsibility",
  "aboutme.skill.learning",
] as const;
---

<section id="aboutme" class="section-shell">
  <div class="section-container">
    <div class="glass-panel about-panel">
      <div class="about-grid">
        <div class="portrait">
          <Image
            src={profilePhoto}
            alt="Brian Vargas"
            widths={[300, 600]}
            sizes="(min-width: 900px) 300px, 55vw"
            loading="lazy"
            class="portrait-img"
          />
        </div>

        <div class="about-content">
          <p class="section-eyebrow" data-translation-key="aboutme.eyebrow">
            {t("aboutme.eyebrow")}
          </p>
          <h2 class="section-title" data-translation-key="aboutme.title">
            {t("aboutme.title")}
          </h2>

          <p class="bio" data-translation-key="aboutme.description">
            {t("aboutme.description")}
          </p>

          <dl class="stats">
            {
              STATS.map((stat) => (
                <div class="stat">
                  <dt class="stat-value">{stat.value}</dt>
                  <dd class="stat-label" data-translation-key={stat.labelKey}>
                    {t(stat.labelKey)}
                  </dd>
                </div>
              ))
            }
          </dl>

          <h3 class="skills-title" data-translation-key="aboutme.softSkills">
            {t("aboutme.softSkills")}
          </h3>
          <ul class="skills">
            {
              SKILLS.map((key) => (
                <li class="skill">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span data-translation-key={key}>{t(key)}</span>
                </li>
              ))
            }
          </ul>

          <div class="cv" id="cv-widget">
            <button class="cv-trigger" type="button" aria-expanded="false" aria-controls="cv-langs">
              <span data-translation-key="aboutme.downloadCV">
                {t("aboutme.downloadCV")}
              </span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
            </button>
            <div class="cv-langs" id="cv-langs">
              <a href="/Brian_Vargas_CV_ES.pdf" download class="cv-link">
                <span class="lang-long" data-translation-key="aboutme.cvEs">{t("aboutme.cvEs")}</span>
                <span class="lang-short">ES</span>
              </a>
              <a href="/Brian_Vargas_CV_EN.pdf" download class="cv-link">
                <span class="lang-long" data-translation-key="aboutme.cvEn">{t("aboutme.cvEn")}</span>
                <span class="lang-short">EN</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="../../i18n/translator.ts"></script>

<script>
  // Expands on hover for pointers and on click/keyboard for everyone else.
  // The previous version only reacted to :hover, so on touch the two language
  // links were unreachable.
  function initCv() {
    const widget = document.getElementById("cv-widget");
    const trigger = widget?.querySelector<HTMLButtonElement>(".cv-trigger");
    if (!widget || !trigger || widget.dataset.bound) return;
    widget.dataset.bound = "true";

    const setOpen = (open: boolean) => {
      widget.classList.toggle("open", open);
      trigger.setAttribute("aria-expanded", String(open));
    };

    trigger.addEventListener("click", () =>
      setOpen(!widget.classList.contains("open")),
    );
    document.addEventListener("click", (e) => {
      if (!widget.contains(e.target as Node)) setOpen(false);
    });
    widget.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Escape") setOpen(false);
    });
  }

  document.addEventListener("DOMContentLoaded", initCv);
  document.addEventListener("astro:page-load", initCv);
</script>

<style>
  .about-panel {
    padding: var(--space-lg);
    overflow: hidden;
  }

  .about-grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(240px, 300px) 1fr;
      justify-items: stretch;
      text-align: left;
    }
  }

  /* Circle, not a 3:4 frame. The source is a circular cut-out, so a taller
   * frame forced transform:scale(1.3) just to hide the transparent corners —
   * that upscaling is what made the photo look soft. At 1:1 it renders at
   * native resolution. */
  .portrait {
    width: min(100%, 300px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid var(--color-accent);
    box-shadow: 0 18px 40px var(--color-shadow);
    transition: transform var(--transition-base);
  }

  @media (hover: hover) {
    .portrait:hover {
      transform: scale(1.03);
    }
  }

  .portrait :global(.portrait-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(12%);
    transition: filter var(--transition-base);
  }

  @media (hover: hover) {
    .portrait:hover :global(.portrait-img) {
      filter: grayscale(0%);
    }
  }

  .about-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: inherit;
  }

  .bio {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: var(--space-2xs) 0 0;
    max-width: 62ch;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: var(--space-md) 0;
    justify-content: center;
  }

  @media (min-width: 900px) {
    .stats {
      justify-content: flex-start;
    }
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent-text);
  }

  .stat-label {
    margin: 0.35rem 0 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .skills-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2xs);
  }

  /* Two even columns instead of loose pills. The old oval tags wrapped into
   * ragged rows on mobile because each one was a different width. */
  .skills {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xs) var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  @media (min-width: 560px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .skill {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  .skill svg {
    flex-shrink: 0;
    color: var(--color-accent-text);
  }

  /* Collapsed pill that expands to the two languages — the interaction from
   * the original design, but reachable by click and keyboard, not hover only,
   * and with dark text on amber instead of white at 1.67:1. */
  .cv {
    position: relative;
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-md);
    border-radius: var(--radius-full);
    background: var(--color-accent);
    box-shadow: 0 6px 18px
      color-mix(in srgb, var(--color-accent) 40%, transparent);
    align-self: center;
    overflow: hidden;
    transition: background var(--transition-fast);
  }

  @media (min-width: 900px) {
    .cv {
      align-self: flex-start;
    }
  }

  .cv:hover {
    background: var(--color-accent-hover);
  }

  .cv-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.4rem;
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-on-accent);
    white-space: nowrap;
  }

  /* Animating max-width made the pill jump: the value is an upper bound, not
   * the real width, so the easing curve did not match the content. A 0fr -> 1fr
   * grid track animates the actual measured width, so the expansion is smooth. */
  .cv-langs {
    display: grid;
    grid-template-columns: 0fr;
    opacity: 0;
    transition:
      grid-template-columns 0.32s var(--ease-out),
      opacity 0.2s var(--ease-out),
      padding-right 0.32s var(--ease-out);
    padding-right: 0;
  }

  .cv-langs > * {
    min-width: 0;
    overflow: hidden;
  }

  .cv.open .cv-langs {
    grid-template-columns: 1fr;
    opacity: 1;
    padding-right: 0.45rem;
  }

  @media (hover: hover) {
    .cv:hover .cv-langs,
    .cv:focus-within .cv-langs {
      grid-template-columns: 1fr;
      opacity: 1;
      padding-right: 0.45rem;
    }
  }

  .cv-langs > * {
    display: flex;
    gap: 0.35rem;
  }

  .cv-link {
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    background: var(--color-on-accent);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition: transform var(--transition-fast);
  }

  /* Full language names when there is room, two-letter codes when there is not. */
  .lang-short {
    display: none;
  }

  @media (max-width: 420px) {
    .lang-long {
      display: none;
    }
    .lang-short {
      display: inline;
    }
  }

  .cv-link:hover {
    transform: translateY(-2px);
  }
</style>
