---
const { t } = Astro.props;

// Reading order across the 2 x 2 grid: left to right, top to bottom.
const AWARDS = [
  { key: "cyber", icon: "shield" },
  { key: "honor", icon: "star" },
  { key: "marathon", icon: "code" },
  { key: "scout", icon: "medal" },
] as const;
---

<section id="awards" class="section-shell">
  <div class="section-container">
    <header class="section-header">
      <p class="section-eyebrow" data-translation-key="awards.eyebrow">
        {t("awards.eyebrow")}
      </p>
      <h2 class="section-title" data-translation-key="awards.title">
        {t("awards.title")}
      </h2>
      <p class="section-lead" data-translation-key="awards.description">
        {t("awards.description")}
      </p>
    </header>

    <div class="awards-grid">
      {
        AWARDS.map((award) => (
          <article class="award-card">
            <div class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
                {award.icon === "shield" && (
                  <>
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <path d="m9 12 2 2 4-4" />
                  </>
                )}
                {award.icon === "code" && (
                  <>
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </>
                )}
                {award.icon === "star" && (
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                )}
                {award.icon === "medal" && (
                  <>
                    <circle cx="12" cy="15" r="6" />
                    <path d="M8.2 10 5 2h14l-3.2 8" />
                  </>
                )}
              </svg>
            </div>

            <div class="head">
              <h3 class="award-title" data-translation-key={`awards.${award.key}.title`}>
                {t(`awards.${award.key}.title`)}
              </h3>
              <span class="date" data-translation-key={`awards.${award.key}.date`}>
                {t(`awards.${award.key}.date`)}
              </span>
            </div>

            <p class="org" data-translation-key={`awards.${award.key}.org`}>
              {t(`awards.${award.key}.org`)}
            </p>

            <p class="desc" data-translation-key={`awards.${award.key}.desc`}>
              {t(`awards.${award.key}.desc`)}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script src="../../i18n/translator.ts"></script>

<style>
  .section-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Four cards: 2 x 2, never 3 + 1. auto-fit was picking 3 columns at wide
   * widths and orphaning the fourth card on its own row. */
  .awards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    max-width: 900px;
    margin-inline: auto;
  }

  @media (min-width: 720px) {
    .awards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .award-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-sm);
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(140%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(140%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    /* The amber rail ties these cards to the education timeline. */
    border-left: 3px solid var(--color-accent);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base);
  }

  @media (hover: hover) {
    .award-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 34px var(--color-shadow);
    }
  }

  .icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
    color: var(--color-accent-text);
    margin-bottom: var(--space-3xs);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3xs);
  }

  .award-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .date {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .org {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent-text);
    margin: 0.2rem 0 0;
  }

  .desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: var(--space-3xs) 0 0;
  }
</style>
